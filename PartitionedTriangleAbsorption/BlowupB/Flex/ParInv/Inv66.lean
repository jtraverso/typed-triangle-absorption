theorem typeWeightF_PAR519_bound (p : V → Fin 4) (z000 z001 z002 z022 z111 z133 z233 z333 E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hz000 : |z000| ≤ 2 * E) (hz001 : |z001| ≤ 8 * E) (hz002 : |z002| ≤ 8 * E) (hz022 : |z022| ≤ 8 * E) (hz111 : |z111| ≤ 2 * E) (hz133 : |z133| ≤ 8 * E) (hz233 : |z233| ≤ 8 * E) (hz333 : |z333| ≤ 2 * E)
