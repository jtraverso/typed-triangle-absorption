  have e4 := mono_normalizer_bound p 1 z111 E δ hE hδ hz111 hm
  have e5 := repeatedType_normalizer_bound p 3 1 z133 E δ hE hδ hz133 hm
  have e6 := repeatedType_normalizer_bound p 3 2 z233 E δ hE hδ hz233 hm
  have e7 := mono_normalizer_bound p 3 z333 E δ hE hδ hz333 hm
  dsimp only [typeWeightF_PAR519, monoTypeWeight, repeatedTypeWeight, tripartiteTypeWeight,
    aabLift, abcLift, pairSymmetrize, aabBase, abcBase]
  generalize ha : p a = i
  generalize hb : p b = j
  generalize hc : p c = k
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp [hab, hac, hbc]
  all_goals first
    | exact e0
    | exact e1
    | exact e2
    | exact e3
    | exact e4
    | exact e5
    | exact e6
    | exact e7
    | exact hM

theorem exists_type_correction_F_PAR519 (p : V → Fin 4) (g : V → V → ℝ) (E δ : ℝ)
