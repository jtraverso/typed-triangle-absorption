theorem vertexWeightF_PAR191_rows (p : V → Fin 4) (d : V → Fin 4 → ℝ)
    (hz : VertexDemandZero p d) (hs : VertexDemandSupported p F_PAR191 d)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
    (hm2 : ∀ i, classSize p i - 2 ≠ 0) (hm3 : ∀ i, classSize p i - 3 ≠ 0) (a : V) (k : Fin 4) :
    classRow p (ternaryLoad (vertexWeightF_PAR191 p d)) a k = d a k := by
  unfold vertexWeightF_PAR191
  simp only [classRow_ternary_add]
  simp only [monoVertexWeight_rows p 0 _ (lc_sum_zero p d hz 1 (-1) 1 0 0) (hm2 0) (hm3 0),
    repeatedVertexWeight_rows p 0 1 _ (lc_sum_zero p d hz 0 1 (-1) 0 0) (hm2 0) (hm 1),
    tripartiteVertexWeight_rows p 0 1 2 _ (lc_sum_zero p d hz 0 0 1 0 0) (hm 1) (hm 2),
    singletonVertexWeight_rows p 0 1 _ (lc_sum_zero p d hz (1 / 2) 0 0 0 1) (hm 0) (hm1 0),
    singletonVertexWeight_rows p 2 1 _ (lc_sum_zero p d hz 0 0 (1 / 2) 0 1) (hm 2) (hm1 2),
    singletonVertexWeight_rows p 3 1 _ (lc_sum_zero p d hz 0 0 0 (1 / 2) 1) (hm 3) (hm1 3),
    tripartiteVertexWeight_rows p 2 0 1 _ (lc_sum_zero p d hz 1 0 0 0 2) (hm 0) (hm 1),
    repeatedVertexWeight_rows p 2 1 _ (lc_sum_zero p d hz (-1) 1 0 0 2) (hm2 2) (hm 1),
    monoVertexWeight_rows p 2 _ (lc_sum_zero p d hz 1 (-1) 1 0 2) (hm2 2) (hm3 2),
    repeatedVertexWeight_rows p 3 1 _ (lc_sum_zero p d hz 0 1 0 0 3) (hm2 3) (hm 1),
    monoVertexWeight_rows p 3 _ (lc_sum_zero p d hz 0 (-1) 0 1 3) (hm2 3) (hm3 3)]
  have hforb := hs a k
  generalize ha : p a = i at hforb ⊢
  fin_cases i <;> fin_cases k <;> simp [lc]
  all_goals first
    | exact (hforb (by unfold Link F_PAR191; decide)).symm
    | ring

theorem vertexWeightF_PAR191_bound (p : V → Fin 4) (d : V → Fin 4 → ℝ) (D δ : ℝ)
    (hD : 0 ≤ D) (hδ : 4 ≤ δ) (hd : ∀ a j, |d a j| ≤ D)
    (hm : ∀ i, δ ≤ classSize p i) (a b c : V) :
    |vertexWeightF_PAR191 p d a b c| ≤ 324 * D / δ ^ 2 := by
  have hf (a0 a1 a2 a3 m : ℝ) (hm0 : |a0| + |a1| + |a2| + |a3| ≤ m) (v : V) :
      |lc d a0 a1 a2 a3 v| ≤ m * D :=
    (lc_bound d D hd a0 a1 a2 a3 v).trans (mul_le_mul_of_nonneg_right hm0 hD)
  have e0 := monoVertexWeight_bound p 0 (lc d 1 (-1) 1 0) (3 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 3) hD) hδ (hf 1 (-1) 1 0 3 (by norm_num)) hm a b c
  rw [show 24 * (3 * D) / δ ^ 2 = (24 * 3) * (D / δ ^ 2) by ring] at e0
  have e1 := (vertexMode_bounds p (lc d 0 1 (-1) 0) (2 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hD) hδ (hf 0 1 (-1) 0 2 (by norm_num)) hm a b c).1 0 1
  rw [show 12 * (2 * D) / δ ^ 2 = (12 * 2) * (D / δ ^ 2) by ring] at e1
  have e2 := (vertexMode_bounds p (lc d 0 0 1 0) (1 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1) hD) hδ (hf 0 0 1 0 1 (by norm_num)) hm a b c).2.2 0 1 2
  rw [show 12 * (1 * D) / δ ^ 2 = (12 * 1) * (D / δ ^ 2) by ring] at e2
  have e3 := (vertexMode_bounds p (lc d (1 / 2) 0 0 0) ((1 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (1 / 2)) hD) hδ (hf (1 / 2) 0 0 0 (1 / 2) (by norm_num)) hm a b c).2.1 0 1
  rw [show 12 * ((1 / 2) * D) / δ ^ 2 = (12 * (1 / 2)) * (D / δ ^ 2) by ring] at e3
  have e4 := (vertexMode_bounds p (lc d 0 0 (1 / 2) 0) ((1 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (1 / 2)) hD) hδ (hf 0 0 (1 / 2) 0 (1 / 2) (by norm_num)) hm a b c).2.1 2 1
  rw [show 12 * ((1 / 2) * D) / δ ^ 2 = (12 * (1 / 2)) * (D / δ ^ 2) by ring] at e4
  have e5 := (vertexMode_bounds p (lc d 0 0 0 (1 / 2)) ((1 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (1 / 2)) hD) hδ (hf 0 0 0 (1 / 2) (1 / 2) (by norm_num)) hm a b c).2.1 3 1
  rw [show 12 * ((1 / 2) * D) / δ ^ 2 = (12 * (1 / 2)) * (D / δ ^ 2) by ring] at e5
  have e6 := (vertexMode_bounds p (lc d 1 0 0 0) (1 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1) hD) hδ (hf 1 0 0 0 1 (by norm_num)) hm a b c).2.2 2 0 1
  rw [show 12 * (1 * D) / δ ^ 2 = (12 * 1) * (D / δ ^ 2) by ring] at e6
  have e7 := (vertexMode_bounds p (lc d (-1) 1 0 0) (2 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hD) hδ (hf (-1) 1 0 0 2 (by norm_num)) hm a b c).1 2 1
  rw [show 12 * (2 * D) / δ ^ 2 = (12 * 2) * (D / δ ^ 2) by ring] at e7
  have e8 := monoVertexWeight_bound p 2 (lc d 1 (-1) 1 0) (3 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 3) hD) hδ (hf 1 (-1) 1 0 3 (by norm_num)) hm a b c
  rw [show 24 * (3 * D) / δ ^ 2 = (24 * 3) * (D / δ ^ 2) by ring] at e8
  have e9 := (vertexMode_bounds p (lc d 0 1 0 0) (1 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1) hD) hδ (hf 0 1 0 0 1 (by norm_num)) hm a b c).1 3 1
  rw [show 12 * (1 * D) / δ ^ 2 = (12 * 1) * (D / δ ^ 2) by ring] at e9
  have e10 := monoVertexWeight_bound p 3 (lc d 0 (-1) 0 1) (2 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hD) hδ (hf 0 (-1) 0 1 2 (by norm_num)) hm a b c
  rw [show 24 * (2 * D) / δ ^ 2 = (24 * 2) * (D / δ ^ 2) by ring] at e10
  have hM0 : 0 ≤ D / δ ^ 2 := by positivity
  unfold vertexWeightF_PAR191
  rw [show 324 * D / δ ^ 2 = 324 * (D / δ ^ 2) by ring]
  generalize D / δ ^ 2 = M at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 hM0 ⊢
  rw [abs_le] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 ⊢
  constructor <;> linarith [e0.1, e0.2, e1.1, e1.2, e2.1, e2.2, e3.1, e3.2, e4.1, e4.2, e5.1, e5.2, e6.1, e6.2, e7.1, e7.2, e8.1, e8.2, e9.1, e9.2, e10.1, e10.2]

