        zeroRowWeightF_PAR190_supported p f,
        zeroRowWeightF_PAR190_load p f hf hr hfd hfs hm hm2 hm4, ?_⟩
      intro a b c
      exact he2 ▸ zeroRowWeightF_PAR190_bound p f (9537 * ε / γ ^ 5) (γ * n)
