/-- **The ternary bounded signed inverse for `F_PAR190` (classes of size at least 8).** -/
theorem ternaryInverse₈_F_PAR190 : TernaryInverse₈ F_PAR190 := by
  intro V _ _ p g ε γ hε hγ hγ1 hlarge8 hmin hsym hd hs hg
  have hlarge : 4 ≤ γ * (Fintype.card V : ℝ) := by linarith
