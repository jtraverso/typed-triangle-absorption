  have e8 := (vertexMode_bounds p (lc d 0 0 0 (1 / 2)) ((1 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (1 / 2)) hD) hδ (hf 0 0 0 (1 / 2) (1 / 2) (by norm_num)) hm a b c).2.1 3 2
