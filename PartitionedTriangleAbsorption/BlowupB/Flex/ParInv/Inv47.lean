  have e3 := repeatedType_normalizer_bound p 2 1 z122 E δ hE hδ hz122 hm
  have e4 := repeatedType_normalizer_bound p 3 1 z133 E δ hE hδ hz133 hm
  have e5 := mono_normalizer_bound p 2 z222 E δ hE hδ hz222 hm
  have e6 := mono_normalizer_bound p 3 z333 E δ hE hδ hz333 hm
  dsimp only [typeWeightF_PAR191, monoTypeWeight, repeatedTypeWeight, tripartiteTypeWeight,
    aabLift, abcLift, pairSymmetrize, aabBase, abcBase]
  generalize ha : p a = i
  generalize hb : p b = j
  generalize hc : p c = k
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp [hab, hac, hbc]
  all_goals first
    | exact e0
    | exact e1
    | exact e2
    | exact e3
    | exact e4
    | exact e5
    | exact e6
    | exact hM

theorem exists_type_correction_F_PAR191 (p : V → Fin 4) (g : V → V → ℝ) (E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hm : ∀ i, δ ≤ classSize p i)
    (hsym : ∀ a b, g a b = g b a) (hs : EdgeSupported p F_PAR191 g)
    (hbound : ∀ i j, |classTotal p g i j| ≤ E) :
    ∃ w : V → V → V → ℝ,
      TernarySymmetric w ∧ TernarySupported p F_PAR191 w ∧
      classTotal p (ternaryLoad w) = classTotal p g ∧
      ∀ a b c, |w a b c| ≤ 32 * E / δ ^ 3 := by
  have b00 := abs_le.mp (hbound 0 0)
  have b01 := abs_le.mp (hbound 0 1)
  have b02 := abs_le.mp (hbound 0 2)
  have b12 := abs_le.mp (hbound 1 2)
  have b13 := abs_le.mp (hbound 1 3)
  have b22 := abs_le.mp (hbound 2 2)
  have b33 := abs_le.mp (hbound 3 3)
  let z000 : ℝ := (1 / 6) * classTotal p g 0 0 + (-1 / 6) * classTotal p g 0 1 + (1 / 6) * classTotal p g 0 2
  let z001 : ℝ := (1 / 2) * classTotal p g 0 1 + (-1 / 2) * classTotal p g 0 2
  let z012 : ℝ := 1 * classTotal p g 0 2
  let z122 : ℝ := (-1 / 2) * classTotal p g 0 2 + (1 / 2) * classTotal p g 1 2
  let z133 : ℝ := (1 / 2) * classTotal p g 1 3
  let z222 : ℝ := (1 / 6) * classTotal p g 0 2 + (-1 / 6) * classTotal p g 1 2 + (1 / 6) * classTotal p g 2 2
  let z333 : ℝ := (-1 / 6) * classTotal p g 1 3 + (1 / 6) * classTotal p g 3 3
  have hz000 : |z000| ≤ 2 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z000] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hz001 : |z001| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z001] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hz012 : |z012| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z012] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hz122 : |z122| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z122] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hz133 : |z133| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z133] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hz222 : |z222| ≤ 2 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z222] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hz333 : |z333| ≤ 2 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z333] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hn (i : Fin 4) : classSize p i ≠ 0 := by have := hm i; linarith
  have hn1 (i : Fin 4) : classSize p i - 1 ≠ 0 := by have := hm i; linarith
  have hn2 (i : Fin 4) : classSize p i - 2 ≠ 0 := by have := hm i; linarith
  refine ⟨typeWeightF_PAR191 p z000 z001 z012 z122 z133 z222 z333, typeWeightF_PAR191_symmetric p _ _ _ _ _ _ _,
    typeWeightF_PAR191_supported p _ _ _ _ _ _ _, ?_,
    typeWeightF_PAR191_bound p _ _ _ _ _ _ _ E δ hE hδ hz000 hz001 hz012 hz122 hz133 hz222 hz333 hm⟩
  rw [typeWeightF_PAR191_totals p _ _ _ _ _ _ _ hn hn1 hn2, classTotal_realMatrixF_PAR191 p g hsym hs]
  congr 1 <;> dsimp only [z000, z001, z012, z122, z133, z222, z333] <;> ring

def vertexWeightF_PAR191 (p : V → Fin 4) (d : V → Fin 4 → ℝ) (a b c : V) : ℝ :=
  monoVertexWeight p 0 (lc d 1 (-1) 1 0) a b c +
  repeatedVertexWeight p 0 1 (lc d 0 1 (-1) 0) a b c +
  tripartiteVertexWeight p 0 1 2 (lc d 0 0 1 0) a b c +
  singletonVertexWeight p 0 1 (lc d (1 / 2) 0 0 0) a b c +
  singletonVertexWeight p 2 1 (lc d 0 0 (1 / 2) 0) a b c +
  singletonVertexWeight p 3 1 (lc d 0 0 0 (1 / 2)) a b c +
  tripartiteVertexWeight p 2 0 1 (lc d 1 0 0 0) a b c +
  repeatedVertexWeight p 2 1 (lc d (-1) 1 0 0) a b c +
  monoVertexWeight p 2 (lc d 1 (-1) 1 0) a b c +
  repeatedVertexWeight p 3 1 (lc d 0 1 0 0) a b c +
  monoVertexWeight p 3 (lc d 0 (-1) 0 1) a b c

theorem vertexWeightF_PAR191_symmetric (p : V → Fin 4) (d : V → Fin 4 → ℝ) :
    TernarySymmetric (vertexWeightF_PAR191 p d) := by
  unfold vertexWeightF_PAR191
