  let z000 : ℝ := (1 / 6) * classTotal p g 0 0 + (-1 / 6) * classTotal p g 0 1 + (-1 / 6) * classTotal p g 0 2 + (-1 / 6) * classTotal p g 1 2 + (1 / 6) * classTotal p g 2 2
