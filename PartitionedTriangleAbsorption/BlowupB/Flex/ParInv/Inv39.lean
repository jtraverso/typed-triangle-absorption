theorem typeWeightF_PAR157_bound (p : V → Fin 4) (z000 z001 z011 z022 z112 z222 z333 E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hz000 : |z000| ≤ 2 * E) (hz001 : |z001| ≤ 8 * E) (hz011 : |z011| ≤ 8 * E) (hz022 : |z022| ≤ 8 * E) (hz112 : |z112| ≤ 8 * E) (hz222 : |z222| ≤ 2 * E) (hz333 : |z333| ≤ 2 * E)
