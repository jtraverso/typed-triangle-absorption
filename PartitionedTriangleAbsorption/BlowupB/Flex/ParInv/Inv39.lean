def vertexWeightF_PAR159 (p : V → Fin 4) (d : V → Fin 4 → ℝ) (a b c : V) : ℝ :=
  repeatedVertexWeight p 0 1 (lc d 1 0 0 0) a b c +
  singletonVertexWeight p 1 0 (lc d (-1 / 2) (1 / 2) 0 0) a b c +
  singletonVertexWeight p 2 0 (lc d 0 0 (1 / 2) 0) a b c +
  singletonVertexWeight p 0 1 (lc d (1 / 2) (-1 / 2) 0 0) a b c +
  repeatedVertexWeight p 1 0 (lc d 0 1 0 0) a b c +
  singletonVertexWeight p 2 1 (lc d 0 0 (1 / 2) 0) a b c +
  singletonVertexWeight p 0 2 (lc d (1 / 2) (1 / 2) (-1 / 2) 0) a b c +
  repeatedVertexWeight p 2 0 (lc d 0 (-1) 1 0) a b c +
  repeatedVertexWeight p 2 1 (lc d 0 1 0 0) a b c +
  monoVertexWeight p 3 (lc d 0 0 0 1) a b c

theorem vertexWeightF_PAR159_symmetric (p : V → Fin 4) (d : V → Fin 4 → ℝ) :
    TernarySymmetric (vertexWeightF_PAR159 p d) := by
  unfold vertexWeightF_PAR159
  repeat' first
    | exact repeatedVertexWeight_symmetric p _ _ _
    | exact singletonVertexWeight_symmetric p _ _ _
    | exact tripartiteVertexWeight_symmetric p _ _ _ _
    | exact monoVertexWeight_symmetric p _ _
    | apply TernarySymmetric.add

theorem vertexWeightF_PAR159_supported (p : V → Fin 4) (d : V → Fin 4 → ℝ) :
    TernarySupported p F_PAR159 (vertexWeightF_PAR159 p d) := by
  unfold vertexWeightF_PAR159
  repeat' first
    | exact monoVertexWeight_supported p F_PAR159 _ (by unfold Link F_PAR159; decide) _
    | exact aabLift_supported p F_PAR159 _ _ (by decide) (by unfold Link F_PAR159; decide) _
    | exact abcLift_supported p F_PAR159 _ _ _ (by decide) (by decide) (by decide)
        (by unfold Link F_PAR159; decide) _
