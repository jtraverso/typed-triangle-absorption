  obtain ⟨z, hbz, hlz⟩ := exists_copy_weights_of_ternary p F_PAR079 w hsw htwF _ hbw
  have hlz' : ∀ e : Sym2 V,
      (∑ S ∈ copies p F_PAR079 (activeCompleteGraph p F_PAR079) with e ∈ triEdges S, z S) = r e := by
    intro e
    induction e using Sym2.ind with
