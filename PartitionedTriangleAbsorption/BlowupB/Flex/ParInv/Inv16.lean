/-- **The ternary bounded signed inverse for `F_PAR066` (classes of size at least 8).** -/
theorem ternaryInverse₈_F_PAR066 : TernaryInverse₈ F_PAR066 := by
  intro V _ _ p g ε γ hε hγ hγ1 hlarge8 hmin hsym hd hs hg
  have hlarge : 4 ≤ γ * (Fintype.card V : ℝ) := by linarith
  let n : ℝ := Fintype.card V
