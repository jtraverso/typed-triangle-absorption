theorem typeWeightF_PAR114_symmetric (p : V → Fin 4) (z000 z001 z002 z012 z111 z122 z333 : ℝ) :
    TernarySymmetric (typeWeightF_PAR114 p z000 z001 z002 z012 z111 z122 z333) := by
