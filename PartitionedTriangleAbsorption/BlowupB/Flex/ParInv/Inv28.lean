theorem vertexWeightF_PAR115_rows (p : V → Fin 4) (d : V → Fin 4 → ℝ)
    (hz : VertexDemandZero p d) (hs : VertexDemandSupported p F_PAR115 d)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
    (hm2 : ∀ i, classSize p i - 2 ≠ 0) (hm3 : ∀ i, classSize p i - 3 ≠ 0) (a : V) (k : Fin 4) :
    classRow p (ternaryLoad (vertexWeightF_PAR115 p d)) a k = d a k := by
  unfold vertexWeightF_PAR115
  simp only [classRow_ternary_add]
  simp only [monoVertexWeight_rows p 0 _ (lc_sum_zero p d hz 1 (-1) 0 0 0) (hm2 0) (hm3 0),
    repeatedVertexWeight_rows p 0 1 _ (lc_sum_zero p d hz 0 1 0 0 0) (hm2 0) (hm 1),
    singletonVertexWeight_rows p 0 1 _ (lc_sum_zero p d hz (1 / 2) 0 0 0 1) (hm 0) (hm1 0),
    repeatedVertexWeight_rows p 1 2 _ (lc_sum_zero p d hz 0 1 0 0 1) (hm2 1) (hm 2),
    singletonVertexWeight_rows p 2 1 _ (lc_sum_zero p d hz 0 (-1 / 2) (1 / 2) 0 1) (hm 2) (hm1 2),
    singletonVertexWeight_rows p 1 2 _ (lc_sum_zero p d hz 0 (1 / 2) (-1 / 2) 0 2) (hm 1) (hm1 1),
    repeatedVertexWeight_rows p 2 1 _ (lc_sum_zero p d hz 0 0 1 0 2) (hm2 2) (hm 1),
