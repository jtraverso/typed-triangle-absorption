theorem typeWeightF_PAR114_totals (p : V → Fin 4) (z000 z001 z002 z012 z111 z122 z333 : ℝ)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
    (hm2 : ∀ i, classSize p i - 2 ≠ 0) :
    classTotal p (ternaryLoad (typeWeightF_PAR114 p z000 z001 z002 z012 z111 z122 z333)) =
      realMatrixF_PAR114 (6 * z000 + 2 * z001 + 2 * z002) (2 * z001 + 1 * z012) (2 * z002 + 1 * z012) (6 * z111) (1 * z012 + 2 * z122) (2 * z122) (6 * z333) := by
  funext i j
  unfold typeWeightF_PAR114
  simp only [classTotal_ternary_add]
  have hmo := fun a z => monoTypeWeight_totals p a z (hm a) (hm1 a) (hm2 a) i j
  have ht := fun a b z => repeatedTypeWeight_totals p a b z (hm a) (hm1 a) (hm b) i j
  have hu := fun a b c z => tripartiteTypeWeight_totals p a b c z (hm a) (hm b) (hm c) i j
  simp only [hmo, ht, hu]
