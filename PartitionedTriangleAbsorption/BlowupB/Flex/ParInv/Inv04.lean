theorem classTotal_realMatrixF_PAR019 (p : V → Fin 4) (g : V → V → ℝ)
    (hsym : ∀ a b, g a b = g b a) (hs : EdgeSupported p F_PAR019 g) :
    classTotal p g = realMatrixF_PAR019 (classTotal p g 0 0) (classTotal p g 0 1) (classTotal p g 0 2) (classTotal p g 1 1) (classTotal p g 1 3) (classTotal p g 2 3) (classTotal p g 3 3) := by
  have h03 := classTotal_zero_of_inactive p F_PAR019 g hs 0 3 (by unfold Link F_PAR019; decide)
  have h12 := classTotal_zero_of_inactive p F_PAR019 g hs 1 2 (by unfold Link F_PAR019; decide)
