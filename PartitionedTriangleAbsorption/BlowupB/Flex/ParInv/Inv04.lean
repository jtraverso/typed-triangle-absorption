theorem typeWeightF_PAR019_totals (p : V → Fin 4) (z000 z001 z002 z011 z133 z233 z333 : ℝ)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
    (hm2 : ∀ i, classSize p i - 2 ≠ 0) :
    classTotal p (ternaryLoad (typeWeightF_PAR019 p z000 z001 z002 z011 z133 z233 z333)) =
      realMatrixF_PAR019 (6 * z000 + 2 * z001 + 2 * z002) (2 * z001 + 2 * z011) (2 * z002) (2 * z011) (2 * z133) (2 * z233) (2 * z133 + 2 * z233 + 6 * z333) := by
  funext i j
  unfold typeWeightF_PAR019
  simp only [classTotal_ternary_add]
  have hmo := fun a z => monoTypeWeight_totals p a z (hm a) (hm1 a) (hm2 a) i j
  have ht := fun a b z => repeatedTypeWeight_totals p a b z (hm a) (hm1 a) (hm b) i j
