theorem typeWeightF_PAR018_bound (p : V → Fin 4) (z000 z001 z002 z113 z133 z233 E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hz000 : |z000| ≤ 2 * E) (hz001 : |z001| ≤ 8 * E) (hz002 : |z002| ≤ 8 * E) (hz113 : |z113| ≤ 8 * E) (hz133 : |z133| ≤ 8 * E) (hz233 : |z233| ≤ 8 * E)
    (hm : ∀ i, δ ≤ classSize p i) (a b c : V) :
    |typeWeightF_PAR018 p z000 z001 z002 z113 z133 z233 a b c| ≤ 32 * E / δ ^ 3 := by
  have hM : 0 ≤ 32 * E / δ ^ 3 := by positivity
  have hsup := typeWeightF_PAR018_supported p z000 z001 z002 z113 z133 z233
  by_cases hdiag : a = b ∨ a = c ∨ b = c
  · have hbad : ¬ AdmissibleTriple p F_PAR018 a b c := by
      intro h
      rcases hdiag with hdiag | hdiag | hdiag
      · exact h.1 hdiag
      · exact h.2.1 hdiag
      · exact h.2.2.1 hdiag
    rw [hsup a b c hbad, abs_zero]
    exact hM
  have hab : a ≠ b := fun h => hdiag (Or.inl h)
  have hac : a ≠ c := fun h => hdiag (Or.inr (Or.inl h))
  have hbc : b ≠ c := fun h => hdiag (Or.inr (Or.inr h))
  have e0 := mono_normalizer_bound p 0 z000 E δ hE hδ hz000 hm
  have e1 := repeatedType_normalizer_bound p 0 1 z001 E δ hE hδ hz001 hm
  have e2 := repeatedType_normalizer_bound p 0 2 z002 E δ hE hδ hz002 hm
  have e3 := repeatedType_normalizer_bound p 1 3 z113 E δ hE hδ hz113 hm
  have e4 := repeatedType_normalizer_bound p 3 1 z133 E δ hE hδ hz133 hm
  have e5 := repeatedType_normalizer_bound p 3 2 z233 E δ hE hδ hz233 hm
  dsimp only [typeWeightF_PAR018, monoTypeWeight, repeatedTypeWeight, tripartiteTypeWeight,
    aabLift, abcLift, pairSymmetrize, aabBase, abcBase]
  generalize ha : p a = i
  generalize hb : p b = j
  generalize hc : p c = k
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp [hab, hac, hbc]
  all_goals first
    | exact e0
    | exact e1
    | exact e2
    | exact e3
    | exact e4
    | exact e5
    | exact hM

/-- The real compatibility of `F_PAR018` on class totals (the charge vanishes on the totals). -/
def CompatF_PAR018 (p : V → Fin 4) (g : V → V → ℝ) : Prop :=
  (1 : ℝ) * classTotal p g 1 1 + (-1 : ℝ) * classTotal p g 1 3 + (-1 : ℝ) * classTotal p g 2 3 + (1 : ℝ) * classTotal p g 3 3 = 0

theorem exists_type_correction_F_PAR018 (p : V → Fin 4) (g : V → V → ℝ) (E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hm : ∀ i, δ ≤ classSize p i)
    (hsym : ∀ a b, g a b = g b a) (hs : EdgeSupported p F_PAR018 g)
    (hcompat : CompatF_PAR018 p g)
    (hbound : ∀ i j, |classTotal p g i j| ≤ E) :
    ∃ w : V → V → V → ℝ,
      TernarySymmetric w ∧ TernarySupported p F_PAR018 w ∧
      classTotal p (ternaryLoad w) = classTotal p g ∧
      ∀ a b c, |w a b c| ≤ 32 * E / δ ^ 3 := by
  unfold CompatF_PAR018 at hcompat
  have b00 := abs_le.mp (hbound 0 0)
  have b01 := abs_le.mp (hbound 0 1)
  have b02 := abs_le.mp (hbound 0 2)
  have b11 := abs_le.mp (hbound 1 1)
  have b13 := abs_le.mp (hbound 1 3)
  have b23 := abs_le.mp (hbound 2 3)
  have b33 := abs_le.mp (hbound 3 3)
  let z000 : ℝ := (1 / 6) * classTotal p g 0 0 + (-1 / 6) * classTotal p g 0 1 + (-1 / 6) * classTotal p g 0 2
  let z001 : ℝ := (1 / 2) * classTotal p g 0 1
  let z002 : ℝ := (1 / 2) * classTotal p g 0 2
  let z113 : ℝ := (1 / 2) * classTotal p g 1 1
  let z133 : ℝ := (-1 / 2) * classTotal p g 1 1 + (1 / 2) * classTotal p g 1 3
  let z233 : ℝ := (1 / 2) * classTotal p g 2 3
  have hz000 : |z000| ≤ 2 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z000] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b13.1, b13.2, b23.1, b23.2, b33.1, b33.2]
  have hz001 : |z001| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z001] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b13.1, b13.2, b23.1, b23.2, b33.1, b33.2]
  have hz002 : |z002| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z002] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b13.1, b13.2, b23.1, b23.2, b33.1, b33.2]
  have hz113 : |z113| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z113] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b13.1, b13.2, b23.1, b23.2, b33.1, b33.2]
  have hz133 : |z133| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z133] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b13.1, b13.2, b23.1, b23.2, b33.1, b33.2]
  have hz233 : |z233| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z233] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b13.1, b13.2, b23.1, b23.2, b33.1, b33.2]
  have hn (i : Fin 4) : classSize p i ≠ 0 := by have := hm i; linarith
  have hn1 (i : Fin 4) : classSize p i - 1 ≠ 0 := by have := hm i; linarith
  have hn2 (i : Fin 4) : classSize p i - 2 ≠ 0 := by have := hm i; linarith
  refine ⟨typeWeightF_PAR018 p z000 z001 z002 z113 z133 z233, typeWeightF_PAR018_symmetric p _ _ _ _ _ _,
    typeWeightF_PAR018_supported p _ _ _ _ _ _, ?_,
    typeWeightF_PAR018_bound p _ _ _ _ _ _ E δ hE hδ hz000 hz001 hz002 hz113 hz133 hz233 hm⟩
  rw [typeWeightF_PAR018_totals p _ _ _ _ _ _ hn hn1 hn2, classTotal_realMatrixF_PAR018 p g hsym hs]
  congr 1 <;> dsimp only [z000, z001, z002, z113, z133, z233] <;> linarith

