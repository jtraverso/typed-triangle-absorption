theorem typeWeightF_PAR017_bound (p : V → Fin 4) (z000 z001 z002 z113 z133 z333 E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hz000 : |z000| ≤ 2 * E) (hz001 : |z001| ≤ 8 * E) (hz002 : |z002| ≤ 8 * E) (hz113 : |z113| ≤ 8 * E) (hz133 : |z133| ≤ 8 * E) (hz333 : |z333| ≤ 2 * E)
