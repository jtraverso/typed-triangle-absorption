  have hz022 : |z022| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z022] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b13.1, b13.2, b22.1, b22.2, b33.1, b33.2]
  have hz113 : |z113| ≤ 8 * E := by
