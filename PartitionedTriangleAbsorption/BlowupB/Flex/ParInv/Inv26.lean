theorem typeWeightF_PAR106_totals (p : V → Fin 4) (z000 z001 z002 z011 z122 z222 z333 : ℝ)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
