  have hn0 : n ≠ 0 := ne_of_gt hn
  have hγ0 : γ ≠ 0 := ne_of_gt hγ
  have hε1 : 0 ≤ 33 * ε / γ ^ 3 := by positivity
  have hε2 : 0 ≤ 9537 * ε / γ ^ 5 := by positivity
  have hm (i : Fin 4) : classSize p i ≠ 0 := by have := hmin i; linarith
  have hm1 (i : Fin 4) : classSize p i - 1 ≠ 0 := by have := hmin i; linarith
  have hm2 (i : Fin 4) : classSize p i - 2 ≠ 0 := by have := hmin i; linarith
  have hm3 (i : Fin 4) : classSize p i - 3 ≠ 0 := by have := hmin i; linarith
  have hm4 (i : Fin 4) : classSize p i - 4 ≠ 0 := by have := hmin i; linarith
  obtain ⟨hstep1, hstep2, hbudget⟩ := complete_inverse_budgets ε γ n hε hγ hγ1 hn
  have he0 : 32 * (ε * n ^ 2) / (γ * n) ^ 3 = 32 * ε / (γ ^ 3 * n) := by
    field_simp [hγ0, hn0]
  have he1 : 288 * (n * (33 * ε / γ ^ 3)) / (γ * n) ^ 2 =
      9504 * ε / (γ ^ 5 * n) := by
    field_simp [hγ0, hn0]
    ring
  have he2 : 96 * (9537 * ε / γ ^ 5) / (γ * n) = 915552 * ε / (γ ^ 6 * n) := by
    field_simp [hγ0, hn0]
    ring
  have hstage : ∃ w : V → V → V → ℝ,
      TernarySymmetric w ∧ TernarySupported p F_PAR107 w ∧ (∀ a b, ternaryLoad w a b = g a b) ∧
      ∀ a b c, |w a b c| ≤
        32 * ε / (γ ^ 3 * n) + 9504 * ε / (γ ^ 5 * n) + 915552 * ε / (γ ^ 6 * n) := by
    apply exists_complete_inverse_of_stages p F_PAR107 g ε _ _ _
      (33 * ε / γ ^ 3) (9537 * ε / γ ^ 5) hε1 hsym hd hs hg hstep1 hstep2
    · obtain ⟨w, hsw, htw, hew, hbw⟩ := exists_type_correction_F_PAR107 p g (ε * n ^ 2)
        (γ * n) (by positivity) hlarge hmin hsym hs hcompat (classTotal_bound p g ε hε hg)
      exact ⟨w, hsw, htw, hew, fun a b c => he0 ▸ hbw a b c⟩
    · intro d hz hds hdb
      refine ⟨vertexWeightF_PAR107 p d, vertexWeightF_PAR107_symmetric p d,
        vertexWeightF_PAR107_supported p d, vertexWeightF_PAR107_rows p d hz hds hm hm1 hm2 hm3, ?_⟩
      intro a b c
      exact he1 ▸ vertexWeightF_PAR107_bound p d (n * (33 * ε / γ ^ 3)) (γ * n)
        (by positivity) hlarge hdb hmin a b c
    · intro f hf hfd hfs hr hb
      refine ⟨zeroRowWeightF_PAR107 p f, zeroRowWeightF_PAR107_symmetric p f hf,
        zeroRowWeightF_PAR107_supported p f,
        zeroRowWeightF_PAR107_load p f hf hr hfd hfs hm hm2 hm4, ?_⟩
      intro a b c
      exact he2 ▸ zeroRowWeightF_PAR107_bound p f (9537 * ε / γ ^ 5) (γ * n)
        hε2 hlarge8 hb hmin a b c
  obtain ⟨w, hsw, htw, hew, hbw⟩ := hstage
  exact ⟨w, hsw, htw, hew, fun a b c => (hbw a b c).trans hbudget⟩

/-- The span compatibility of `CompleteInverseCert₈` gives the real compatibility of `F_PAR107`. -/
theorem compatF_PAR107_of_span (p : V → Fin 4) (r : Sym2 V → ℝ) (h : SpanCompat p F_PAR107 r) :
    CompatF_PAR107 p (fun a b => r s(a, b)) := by
  obtain ⟨c, hc⟩ := h
  have e := fun i j => congrFun (congrFun hc i) j
  have e00 := e 0 0; have e01 := e 0 1; have e11 := e 1 1; have e12 := e 1 2; have e22 := e 2 2; have e23 := e 2 3; have e33 := e 3 3
  simp (config := {decide := true}) only [F_PAR107, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
    sum_insert, mem_insert, mem_singleton, sum_singleton, typeEdgeVec] at e00 e01 e11 e12 e22 e23 e33
  simp (config := {decide := true}) at e00 e01 e11 e12 e22 e23 e33
  unfold CompatF_PAR107
  linarith

/-- **`CompleteInverseCert₈ F_PAR107`** (with the charge compatibility). -/
theorem completeInverseCert₈_F_PAR107 : CompleteInverseCert₈ F_PAR107 := by
  intro V _ _ p r ε γ hε hγ hγ1 hlarge hmin hs hr hspan
  have hsE : EdgeSupported p F_PAR107 (fun a b => r s(a, b)) := fun a b hab =>
    hs.edgeSupported a b hab
  obtain ⟨w, hsw, htw, hlw, hbw⟩ := ternaryInverse₈_F_PAR107 V p (fun a b => r s(a, b)) ε γ
    hε hγ hγ1 hlarge hmin (fun a b => congrArg r Sym2.eq_swap) hs.diag hsE
    (fun a b => hr s(a, b)) (compatF_PAR107_of_span p r hspan)
  have htwF : TernarySupported p F_PAR107 w := htw
  obtain ⟨z, hbz, hlz⟩ := exists_copy_weights_of_ternary p F_PAR107 w hsw htwF _ hbw
  have hlz' : ∀ e : Sym2 V,
      (∑ S ∈ copies p F_PAR107 (activeCompleteGraph p F_PAR107) with e ∈ triEdges S, z S) = r e := by
    intro e
    induction e using Sym2.ind with
    | _ a b =>
      by_cases hab : a = b
      · subst b
        rw [copy_load_diag, hs.diag]
      · exact (hlz a b hab).trans (hlw a b)
  refine ⟨copyRestriction p F_PAR107 (activeCompleteGraph p F_PAR107) z,
    copyRestriction_supported p F_PAR107 (activeCompleteGraph p F_PAR107) z, ?_, ?_⟩
  · funext e
    exact (copyRestriction_boundary p F_PAR107 (activeCompleteGraph p F_PAR107) z e).trans (hlz' e)
  · intro T
    by_cases hT : IsCopy p F_PAR107 (activeCompleteGraph p F_PAR107) T
    · simpa only [copyRestriction, hT, ite_true] using hbz T hT
    · simp only [copyRestriction, hT, ite_false, abs_zero]
      positivity

end PaddedComponents

