theorem typeWeightF_PAR105_totals (p : V → Fin 4) (z000 z001 z022 z112 z122 z333 : ℝ)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
    (hm2 : ∀ i, classSize p i - 2 ≠ 0) :
    classTotal p (ternaryLoad (typeWeightF_PAR105 p z000 z001 z022 z112 z122 z333)) =
      realMatrixF_PAR105 (6 * z000 + 2 * z001) (2 * z001) (2 * z022) (2 * z112) (2 * z112 + 2 * z122) (2 * z022 + 2 * z122) (6 * z333) := by
  funext i j
  unfold typeWeightF_PAR105
  simp only [classTotal_ternary_add]
  have hmo := fun a z => monoTypeWeight_totals p a z (hm a) (hm1 a) (hm2 a) i j
  have ht := fun a b z => repeatedTypeWeight_totals p a b z (hm a) (hm1 a) (hm b) i j
  have hu := fun a b c z => tripartiteTypeWeight_totals p a b c z (hm a) (hm b) (hm c) i j
  simp only [hmo, ht, hu]
  fin_cases i <;> fin_cases j <;> simp [realMatrixF_PAR105] <;> ring

theorem typeWeightF_PAR105_bound (p : V → Fin 4) (z000 z001 z022 z112 z122 z333 E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hz000 : |z000| ≤ 2 * E) (hz001 : |z001| ≤ 8 * E) (hz022 : |z022| ≤ 8 * E) (hz112 : |z112| ≤ 8 * E) (hz122 : |z122| ≤ 8 * E) (hz333 : |z333| ≤ 2 * E)
    (hm : ∀ i, δ ≤ classSize p i) (a b c : V) :
    |typeWeightF_PAR105 p z000 z001 z022 z112 z122 z333 a b c| ≤ 32 * E / δ ^ 3 := by
  have hM : 0 ≤ 32 * E / δ ^ 3 := by positivity
  have hsup := typeWeightF_PAR105_supported p z000 z001 z022 z112 z122 z333
  by_cases hdiag : a = b ∨ a = c ∨ b = c
  · have hbad : ¬ AdmissibleTriple p F_PAR105 a b c := by
      intro h
      rcases hdiag with hdiag | hdiag | hdiag
      · exact h.1 hdiag
      · exact h.2.1 hdiag
      · exact h.2.2.1 hdiag
    rw [hsup a b c hbad, abs_zero]
    exact hM
  have hab : a ≠ b := fun h => hdiag (Or.inl h)
  have hac : a ≠ c := fun h => hdiag (Or.inr (Or.inl h))
  have hbc : b ≠ c := fun h => hdiag (Or.inr (Or.inr h))
  have e0 := mono_normalizer_bound p 0 z000 E δ hE hδ hz000 hm
  have e1 := repeatedType_normalizer_bound p 0 1 z001 E δ hE hδ hz001 hm
  have e2 := repeatedType_normalizer_bound p 2 0 z022 E δ hE hδ hz022 hm
  have e3 := repeatedType_normalizer_bound p 1 2 z112 E δ hE hδ hz112 hm
  have e4 := repeatedType_normalizer_bound p 2 1 z122 E δ hE hδ hz122 hm
  have e5 := mono_normalizer_bound p 3 z333 E δ hE hδ hz333 hm
  dsimp only [typeWeightF_PAR105, monoTypeWeight, repeatedTypeWeight, tripartiteTypeWeight,
    aabLift, abcLift, pairSymmetrize, aabBase, abcBase]
  generalize ha : p a = i
  generalize hb : p b = j
  generalize hc : p c = k
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp [hab, hac, hbc]
  all_goals first
    | exact e0
    | exact e1
    | exact e2
    | exact e3
    | exact e4
    | exact e5
    | exact hM

/-- The real compatibility of `F_PAR105` on class totals (the charge vanishes on the totals). -/
def CompatF_PAR105 (p : V → Fin 4) (g : V → V → ℝ) : Prop :=
  (-1 : ℝ) * classTotal p g 0 2 + (1 : ℝ) * classTotal p g 1 1 + (-1 : ℝ) * classTotal p g 1 2 + (1 : ℝ) * classTotal p g 2 2 = 0

theorem exists_type_correction_F_PAR105 (p : V → Fin 4) (g : V → V → ℝ) (E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hm : ∀ i, δ ≤ classSize p i)
    (hsym : ∀ a b, g a b = g b a) (hs : EdgeSupported p F_PAR105 g)
    (hcompat : CompatF_PAR105 p g)
    (hbound : ∀ i j, |classTotal p g i j| ≤ E) :
    ∃ w : V → V → V → ℝ,
      TernarySymmetric w ∧ TernarySupported p F_PAR105 w ∧
      classTotal p (ternaryLoad w) = classTotal p g ∧
      ∀ a b c, |w a b c| ≤ 32 * E / δ ^ 3 := by
  unfold CompatF_PAR105 at hcompat
  have b00 := abs_le.mp (hbound 0 0)
  have b01 := abs_le.mp (hbound 0 1)
  have b02 := abs_le.mp (hbound 0 2)
  have b11 := abs_le.mp (hbound 1 1)
  have b12 := abs_le.mp (hbound 1 2)
  have b22 := abs_le.mp (hbound 2 2)
  have b33 := abs_le.mp (hbound 3 3)
  let z000 : ℝ := (1 / 6) * classTotal p g 0 0 + (-1 / 6) * classTotal p g 0 1
  let z001 : ℝ := (1 / 2) * classTotal p g 0 1
  let z022 : ℝ := (1 / 2) * classTotal p g 0 2
  let z112 : ℝ := (1 / 2) * classTotal p g 1 1
  let z122 : ℝ := (-1 / 2) * classTotal p g 1 1 + (1 / 2) * classTotal p g 1 2
  let z333 : ℝ := (1 / 6) * classTotal p g 3 3
  have hz000 : |z000| ≤ 2 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z000] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b12.1, b12.2, b22.1, b22.2, b33.1, b33.2]
  have hz001 : |z001| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z001] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b12.1, b12.2, b22.1, b22.2, b33.1, b33.2]
  have hz022 : |z022| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z022] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b12.1, b12.2, b22.1, b22.2, b33.1, b33.2]
  have hz112 : |z112| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z112] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b12.1, b12.2, b22.1, b22.2, b33.1, b33.2]
  have hz122 : |z122| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z122] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b12.1, b12.2, b22.1, b22.2, b33.1, b33.2]
  have hz333 : |z333| ≤ 2 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z333] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b02.1, b02.2, b11.1, b11.2, b12.1, b12.2, b22.1, b22.2, b33.1, b33.2]
  have hn (i : Fin 4) : classSize p i ≠ 0 := by have := hm i; linarith
  have hn1 (i : Fin 4) : classSize p i - 1 ≠ 0 := by have := hm i; linarith
  have hn2 (i : Fin 4) : classSize p i - 2 ≠ 0 := by have := hm i; linarith
  refine ⟨typeWeightF_PAR105 p z000 z001 z022 z112 z122 z333, typeWeightF_PAR105_symmetric p _ _ _ _ _ _,
    typeWeightF_PAR105_supported p _ _ _ _ _ _, ?_,
    typeWeightF_PAR105_bound p _ _ _ _ _ _ E δ hE hδ hz000 hz001 hz022 hz112 hz122 hz333 hm⟩
  rw [typeWeightF_PAR105_totals p _ _ _ _ _ _ hn hn1 hn2, classTotal_realMatrixF_PAR105 p g hsym hs]
  congr 1 <;> dsimp only [z000, z001, z022, z112, z122, z333] <;> linarith

