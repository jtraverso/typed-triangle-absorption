  simp only [monoVertexWeight_rows p 0 _ (lc_sum_zero p d hz 1 (-1) 0 0 0) (hm2 0) (hm3 0),
    repeatedVertexWeight_rows p 0 1 _ (lc_sum_zero p d hz 0 1 0 0 0) (hm2 0) (hm 1),
    singletonVertexWeight_rows p 2 0 _ (lc_sum_zero p d hz 0 0 (1 / 2) 0 0) (hm 2) (hm1 2),
