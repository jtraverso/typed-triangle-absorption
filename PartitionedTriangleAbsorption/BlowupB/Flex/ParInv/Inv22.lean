def realMatrixF_PAR088 (t00 t01 t12 t13 t22 t23 t33 : ℝ) : Fin 4 → Fin 4 → ℝ :=
  ![![t00, t01, 0, 0], ![t01, 0, t12, t13], ![0, t12, t22, t23], ![0, t13, t23, t33]]

theorem classTotal_realMatrixF_PAR088 (p : V → Fin 4) (g : V → V → ℝ)
    (hsym : ∀ a b, g a b = g b a) (hs : EdgeSupported p F_PAR088 g) :
    classTotal p g = realMatrixF_PAR088 (classTotal p g 0 0) (classTotal p g 0 1) (classTotal p g 1 2) (classTotal p g 1 3) (classTotal p g 2 2) (classTotal p g 2 3) (classTotal p g 3 3) := by
  have h02 := classTotal_zero_of_inactive p F_PAR088 g hs 0 2 (by unfold Link F_PAR088; decide)
  have h03 := classTotal_zero_of_inactive p F_PAR088 g hs 0 3 (by unfold Link F_PAR088; decide)
  have h11 := classTotal_zero_of_inactive p F_PAR088 g hs 1 1 (by unfold Link F_PAR088; decide)
  funext i j
  fin_cases i <;> fin_cases j <;>
    simp [realMatrixF_PAR088, classTotal_symmetric p g hsym 1 0, classTotal_symmetric p g hsym 2 0,
      classTotal_symmetric p g hsym 3 0, classTotal_symmetric p g hsym 2 1,
      classTotal_symmetric p g hsym 3 1, classTotal_symmetric p g hsym 3 2, h02, h03, h11]

def typeWeightF_PAR088 (p : V → Fin 4) (z000 z001 z122 z123 z133 z223 : ℝ) (a b c : V) : ℝ :=
  monoTypeWeight p 0 z000 a b c +
  repeatedTypeWeight p 0 1 z001 a b c +
  repeatedTypeWeight p 2 1 z122 a b c +
  tripartiteTypeWeight p 1 2 3 z123 a b c +
  repeatedTypeWeight p 3 1 z133 a b c +
  repeatedTypeWeight p 2 3 z223 a b c

theorem typeWeightF_PAR088_symmetric (p : V → Fin 4) (z000 z001 z122 z123 z133 z223 : ℝ) :
    TernarySymmetric (typeWeightF_PAR088 p z000 z001 z122 z123 z133 z223) := by
  unfold typeWeightF_PAR088
  repeat' first
    | with_reducible apply TernarySymmetric.add
    | with_reducible exact monoTypeWeight_symmetric p _ _
    | with_reducible exact repeatedTypeWeight_symmetric p _ _ _
    | with_reducible exact tripartiteTypeWeight_symmetric p _ _ _ _
    | exact monoTypeWeight_symmetric p _ _
    | exact repeatedTypeWeight_symmetric p _ _ _
    | exact tripartiteTypeWeight_symmetric p _ _ _ _
    | apply TernarySymmetric.add

theorem typeWeightF_PAR088_supported (p : V → Fin 4) (z000 z001 z122 z123 z133 z223 : ℝ) :
    TernarySupported p F_PAR088 (typeWeightF_PAR088 p z000 z001 z122 z123 z133 z223) := by
  unfold typeWeightF_PAR088
  repeat' first
    | with_reducible apply TernarySupported.add
    | exact monoTypeWeight_supported p F_PAR088 _ (by unfold Link F_PAR088; decide) _
    | exact aabLift_supported p F_PAR088 _ _ (by decide) (by unfold Link F_PAR088; decide) _
    | exact abcLift_supported p F_PAR088 _ _ _ (by decide) (by decide) (by decide)
        (by unfold Link F_PAR088; decide) _
    | apply TernarySupported.add

theorem typeWeightF_PAR088_totals (p : V → Fin 4) (z000 z001 z122 z123 z133 z223 : ℝ)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
    (hm2 : ∀ i, classSize p i - 2 ≠ 0) :
    classTotal p (ternaryLoad (typeWeightF_PAR088 p z000 z001 z122 z123 z133 z223)) =
      realMatrixF_PAR088 (6 * z000 + 2 * z001) (2 * z001) (2 * z122 + 1 * z123) (1 * z123 + 2 * z133) (2 * z122 + 2 * z223) (1 * z123 + 2 * z223) (2 * z133) := by
  funext i j
  unfold typeWeightF_PAR088
  simp only [classTotal_ternary_add]
  have hmo := fun a z => monoTypeWeight_totals p a z (hm a) (hm1 a) (hm2 a) i j
  have ht := fun a b z => repeatedTypeWeight_totals p a b z (hm a) (hm1 a) (hm b) i j
  have hu := fun a b c z => tripartiteTypeWeight_totals p a b c z (hm a) (hm b) (hm c) i j
  simp only [hmo, ht, hu]
  fin_cases i <;> fin_cases j <;> simp [realMatrixF_PAR088] <;> ring

theorem typeWeightF_PAR088_bound (p : V → Fin 4) (z000 z001 z122 z123 z133 z223 E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hz000 : |z000| ≤ 2 * E) (hz001 : |z001| ≤ 8 * E) (hz122 : |z122| ≤ 8 * E) (hz123 : |z123| ≤ 8 * E) (hz133 : |z133| ≤ 8 * E) (hz223 : |z223| ≤ 8 * E)
    (hm : ∀ i, δ ≤ classSize p i) (a b c : V) :
    |typeWeightF_PAR088 p z000 z001 z122 z123 z133 z223 a b c| ≤ 32 * E / δ ^ 3 := by
  have hM : 0 ≤ 32 * E / δ ^ 3 := by positivity
  have hsup := typeWeightF_PAR088_supported p z000 z001 z122 z123 z133 z223
  by_cases hdiag : a = b ∨ a = c ∨ b = c
  · have hbad : ¬ AdmissibleTriple p F_PAR088 a b c := by
      intro h
      rcases hdiag with hdiag | hdiag | hdiag
      · exact h.1 hdiag
      · exact h.2.1 hdiag
      · exact h.2.2.1 hdiag
    rw [hsup a b c hbad, abs_zero]
    exact hM
  have hab : a ≠ b := fun h => hdiag (Or.inl h)
  have hac : a ≠ c := fun h => hdiag (Or.inr (Or.inl h))
  have hbc : b ≠ c := fun h => hdiag (Or.inr (Or.inr h))
  have e0 := mono_normalizer_bound p 0 z000 E δ hE hδ hz000 hm
  have e1 := repeatedType_normalizer_bound p 0 1 z001 E δ hE hδ hz001 hm
  have e2 := repeatedType_normalizer_bound p 2 1 z122 E δ hE hδ hz122 hm
  have e3 := tripartiteType_normalizer_bound p 1 2 3 z123 E δ hE hδ hz123 hm
  have e4 := repeatedType_normalizer_bound p 3 1 z133 E δ hE hδ hz133 hm
  have e5 := repeatedType_normalizer_bound p 2 3 z223 E δ hE hδ hz223 hm
  dsimp only [typeWeightF_PAR088, monoTypeWeight, repeatedTypeWeight, tripartiteTypeWeight,
    aabLift, abcLift, pairSymmetrize, aabBase, abcBase]
  generalize ha : p a = i
  generalize hb : p b = j
  generalize hc : p c = k
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp [hab, hac, hbc]
  all_goals first
    | exact e0
    | exact e1
    | exact e2
    | exact e3
    | exact e4
    | exact e5
    | exact hM

/-- The real compatibility of `F_PAR088` on class totals (the charge vanishes on the totals). -/
def CompatF_PAR088 (p : V → Fin 4) (g : V → V → ℝ) : Prop :=
  (1 : ℝ) * classTotal p g 1 2 + (-2 : ℝ) * classTotal p g 1 3 + (-1 : ℝ) * classTotal p g 2 2 + (1 : ℝ) * classTotal p g 2 3 + (2 : ℝ) * classTotal p g 3 3 = 0

theorem exists_type_correction_F_PAR088 (p : V → Fin 4) (g : V → V → ℝ) (E δ : ℝ)
    (hE : 0 ≤ E) (hδ : 4 ≤ δ) (hm : ∀ i, δ ≤ classSize p i)
    (hsym : ∀ a b, g a b = g b a) (hs : EdgeSupported p F_PAR088 g)
    (hcompat : CompatF_PAR088 p g)
    (hbound : ∀ i j, |classTotal p g i j| ≤ E) :
    ∃ w : V → V → V → ℝ,
      TernarySymmetric w ∧ TernarySupported p F_PAR088 w ∧
      classTotal p (ternaryLoad w) = classTotal p g ∧
      ∀ a b c, |w a b c| ≤ 32 * E / δ ^ 3 := by
  unfold CompatF_PAR088 at hcompat
  have b00 := abs_le.mp (hbound 0 0)
  have b01 := abs_le.mp (hbound 0 1)
  have b12 := abs_le.mp (hbound 1 2)
  have b13 := abs_le.mp (hbound 1 3)
  have b22 := abs_le.mp (hbound 2 2)
  have b23 := abs_le.mp (hbound 2 3)
  have b33 := abs_le.mp (hbound 3 3)
  let z000 : ℝ := (1 / 6) * classTotal p g 0 0 + (-1 / 6) * classTotal p g 0 1
  let z001 : ℝ := (1 / 2) * classTotal p g 0 1
  let z122 : ℝ := (1 / 4) * classTotal p g 1 2 + (1 / 4) * classTotal p g 2 2 + (-1 / 4) * classTotal p g 2 3
  let z123 : ℝ := (1 / 2) * classTotal p g 1 2 + (-1 / 2) * classTotal p g 2 2 + (1 / 2) * classTotal p g 2 3
  let z133 : ℝ := (1 / 2) * classTotal p g 3 3
  let z223 : ℝ := (-1 / 4) * classTotal p g 1 2 + (1 / 4) * classTotal p g 2 2 + (1 / 4) * classTotal p g 2 3
  have hz000 : |z000| ≤ 2 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z000] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b23.1, b23.2, b33.1, b33.2]
  have hz001 : |z001| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z001] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b23.1, b23.2, b33.1, b33.2]
  have hz122 : |z122| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z122] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b23.1, b23.2, b33.1, b33.2]
  have hz123 : |z123| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z123] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b23.1, b23.2, b33.1, b33.2]
  have hz133 : |z133| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z133] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b23.1, b23.2, b33.1, b33.2]
  have hz223 : |z223| ≤ 8 * E := by
    apply abs_le.mpr; constructor <;> dsimp only [z223] <;>
      linarith [b00.1, b00.2, b01.1, b01.2, b12.1, b12.2, b13.1, b13.2, b22.1, b22.2, b23.1, b23.2, b33.1, b33.2]
  have hn (i : Fin 4) : classSize p i ≠ 0 := by have := hm i; linarith
  have hn1 (i : Fin 4) : classSize p i - 1 ≠ 0 := by have := hm i; linarith
  have hn2 (i : Fin 4) : classSize p i - 2 ≠ 0 := by have := hm i; linarith
  refine ⟨typeWeightF_PAR088 p z000 z001 z122 z123 z133 z223, typeWeightF_PAR088_symmetric p _ _ _ _ _ _,
    typeWeightF_PAR088_supported p _ _ _ _ _ _, ?_,
    typeWeightF_PAR088_bound p _ _ _ _ _ _ E δ hE hδ hz000 hz001 hz122 hz123 hz133 hz223 hm⟩
  rw [typeWeightF_PAR088_totals p _ _ _ _ _ _ hn hn1 hn2, classTotal_realMatrixF_PAR088 p g hsym hs]
  congr 1 <;> dsimp only [z000, z001, z122, z123, z133, z223] <;> linarith

def vertexWeightF_PAR088 (p : V → Fin 4) (d : V → Fin 4 → ℝ) (a b c : V) : ℝ :=
  monoVertexWeight p 0 (lc d 1 (-1) 0 0) a b c +
  repeatedVertexWeight p 0 1 (lc d 0 1 0 0) a b c +
  singletonVertexWeight p 0 1 (lc d (1 / 2) 0 0 0) a b c +
  singletonVertexWeight p 2 1 (lc d 0 0 (1 / 2) 0) a b c +
  singletonVertexWeight p 3 1 (lc d 0 0 0 (1 / 2)) a b c +
  repeatedVertexWeight p 2 1 (lc d 0 (1 / 2) (1 / 2) (-1 / 2)) a b c +
  tripartiteVertexWeight p 2 1 3 (lc d 0 (1 / 2) (-1 / 2) (1 / 2)) a b c +
  repeatedVertexWeight p 2 3 (lc d 0 (-1 / 2) (1 / 2) (1 / 2)) a b c +
  tripartiteVertexWeight p 3 1 2 (lc d 0 1 0 (-1)) a b c +
  repeatedVertexWeight p 3 1 (lc d 0 0 0 1) a b c +
  singletonVertexWeight p 2 3 (lc d 0 (-1 / 2) (1 / 2) (1 / 2)) a b c

theorem vertexWeightF_PAR088_symmetric (p : V → Fin 4) (d : V → Fin 4 → ℝ) :
    TernarySymmetric (vertexWeightF_PAR088 p d) := by
  unfold vertexWeightF_PAR088
  repeat' first
    | with_reducible apply TernarySymmetric.add
    | with_reducible exact repeatedVertexWeight_symmetric p _ _ _
    | with_reducible exact singletonVertexWeight_symmetric p _ _ _
    | with_reducible exact tripartiteVertexWeight_symmetric p _ _ _ _
    | with_reducible exact monoVertexWeight_symmetric p _ _
    | exact repeatedVertexWeight_symmetric p _ _ _
    | exact singletonVertexWeight_symmetric p _ _ _
    | exact tripartiteVertexWeight_symmetric p _ _ _ _
    | exact monoVertexWeight_symmetric p _ _
    | apply TernarySymmetric.add

theorem vertexWeightF_PAR088_supported (p : V → Fin 4) (d : V → Fin 4 → ℝ) :
    TernarySupported p F_PAR088 (vertexWeightF_PAR088 p d) := by
  unfold vertexWeightF_PAR088
  repeat' first
    | with_reducible apply TernarySupported.add
    | exact monoVertexWeight_supported p F_PAR088 _ (by unfold Link F_PAR088; decide) _
    | exact aabLift_supported p F_PAR088 _ _ (by decide) (by unfold Link F_PAR088; decide) _
    | exact abcLift_supported p F_PAR088 _ _ _ (by decide) (by decide) (by decide)
        (by unfold Link F_PAR088; decide) _
    | apply TernarySupported.add

theorem vertexWeightF_PAR088_rows (p : V → Fin 4) (d : V → Fin 4 → ℝ)
    (hz : VertexDemandZero p d) (hs : VertexDemandSupported p F_PAR088 d)
    (hm : ∀ i, classSize p i ≠ 0) (hm1 : ∀ i, classSize p i - 1 ≠ 0)
    (hm2 : ∀ i, classSize p i - 2 ≠ 0) (hm3 : ∀ i, classSize p i - 3 ≠ 0) (a : V) (k : Fin 4) :
    classRow p (ternaryLoad (vertexWeightF_PAR088 p d)) a k = d a k := by
  unfold vertexWeightF_PAR088
  simp only [classRow_ternary_add]
  simp only [monoVertexWeight_rows p 0 _ (lc_sum_zero p d hz 1 (-1) 0 0 0) (hm2 0) (hm3 0),
    repeatedVertexWeight_rows p 0 1 _ (lc_sum_zero p d hz 0 1 0 0 0) (hm2 0) (hm 1),
    singletonVertexWeight_rows p 0 1 _ (lc_sum_zero p d hz (1 / 2) 0 0 0 1) (hm 0) (hm1 0),
    singletonVertexWeight_rows p 2 1 _ (lc_sum_zero p d hz 0 0 (1 / 2) 0 1) (hm 2) (hm1 2),
    singletonVertexWeight_rows p 3 1 _ (lc_sum_zero p d hz 0 0 0 (1 / 2) 1) (hm 3) (hm1 3),
    repeatedVertexWeight_rows p 2 1 _ (lc_sum_zero p d hz 0 (1 / 2) (1 / 2) (-1 / 2) 2) (hm2 2) (hm 1),
    tripartiteVertexWeight_rows p 2 1 3 _ (lc_sum_zero p d hz 0 (1 / 2) (-1 / 2) (1 / 2) 2) (hm 1) (hm 3),
    repeatedVertexWeight_rows p 2 3 _ (lc_sum_zero p d hz 0 (-1 / 2) (1 / 2) (1 / 2) 2) (hm2 2) (hm 3),
    tripartiteVertexWeight_rows p 3 1 2 _ (lc_sum_zero p d hz 0 1 0 (-1) 3) (hm 1) (hm 2),
    repeatedVertexWeight_rows p 3 1 _ (lc_sum_zero p d hz 0 0 0 1 3) (hm2 3) (hm 1),
    singletonVertexWeight_rows p 2 3 _ (lc_sum_zero p d hz 0 (-1 / 2) (1 / 2) (1 / 2) 3) (hm 2) (hm1 2)]
  have hforb := hs a k
  generalize ha : p a = i at hforb ⊢
  fin_cases i <;> fin_cases k <;> simp [lc]
  all_goals first
    | exact (hforb (by unfold Link F_PAR088; decide)).symm
    | ring

theorem vertexWeightF_PAR088_bound (p : V → Fin 4) (d : V → Fin 4 → ℝ) (D δ : ℝ)
    (hD : 0 ≤ D) (hδ : 4 ≤ δ) (hd : ∀ a j, |d a j| ≤ D)
    (hm : ∀ i, δ ≤ classSize p i) (a b c : V) :
    |vertexWeightF_PAR088 p d a b c| ≤ 288 * D / δ ^ 2 := by
  have hf (a0 a1 a2 a3 m : ℝ) (hm0 : |a0| + |a1| + |a2| + |a3| ≤ m) (v : V) :
      |lc d a0 a1 a2 a3 v| ≤ m * D :=
    (lc_bound d D hd a0 a1 a2 a3 v).trans (mul_le_mul_of_nonneg_right hm0 hD)
  have e0 := monoVertexWeight_bound p 0 (lc d 1 (-1) 0 0) (2 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hD) hδ (hf 1 (-1) 0 0 2 (by norm_num)) hm a b c
  rw [show 24 * (2 * D) / δ ^ 2 = (24 * 2) * (D / δ ^ 2) by ring] at e0
  have e1 := (vertexMode_bounds p (lc d 0 1 0 0) (1 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1) hD) hδ (hf 0 1 0 0 1 (by norm_num)) hm a b c).1 0 1
  rw [show 12 * (1 * D) / δ ^ 2 = (12 * 1) * (D / δ ^ 2) by ring] at e1
  have e2 := (vertexMode_bounds p (lc d (1 / 2) 0 0 0) ((1 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (1 / 2)) hD) hδ (hf (1 / 2) 0 0 0 (1 / 2) (by norm_num)) hm a b c).2.1 0 1
  rw [show 12 * ((1 / 2) * D) / δ ^ 2 = (12 * (1 / 2)) * (D / δ ^ 2) by ring] at e2
  have e3 := (vertexMode_bounds p (lc d 0 0 (1 / 2) 0) ((1 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (1 / 2)) hD) hδ (hf 0 0 (1 / 2) 0 (1 / 2) (by norm_num)) hm a b c).2.1 2 1
  rw [show 12 * ((1 / 2) * D) / δ ^ 2 = (12 * (1 / 2)) * (D / δ ^ 2) by ring] at e3
  have e4 := (vertexMode_bounds p (lc d 0 0 0 (1 / 2)) ((1 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (1 / 2)) hD) hδ (hf 0 0 0 (1 / 2) (1 / 2) (by norm_num)) hm a b c).2.1 3 1
  rw [show 12 * ((1 / 2) * D) / δ ^ 2 = (12 * (1 / 2)) * (D / δ ^ 2) by ring] at e4
  have e5 := (vertexMode_bounds p (lc d 0 (1 / 2) (1 / 2) (-1 / 2)) ((3 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (3 / 2)) hD) hδ (hf 0 (1 / 2) (1 / 2) (-1 / 2) (3 / 2) (by norm_num)) hm a b c).1 2 1
  rw [show 12 * ((3 / 2) * D) / δ ^ 2 = (12 * (3 / 2)) * (D / δ ^ 2) by ring] at e5
  have e6 := (vertexMode_bounds p (lc d 0 (1 / 2) (-1 / 2) (1 / 2)) ((3 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (3 / 2)) hD) hδ (hf 0 (1 / 2) (-1 / 2) (1 / 2) (3 / 2) (by norm_num)) hm a b c).2.2 2 1 3
  rw [show 12 * ((3 / 2) * D) / δ ^ 2 = (12 * (3 / 2)) * (D / δ ^ 2) by ring] at e6
  have e7 := (vertexMode_bounds p (lc d 0 (-1 / 2) (1 / 2) (1 / 2)) ((3 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (3 / 2)) hD) hδ (hf 0 (-1 / 2) (1 / 2) (1 / 2) (3 / 2) (by norm_num)) hm a b c).1 2 3
  rw [show 12 * ((3 / 2) * D) / δ ^ 2 = (12 * (3 / 2)) * (D / δ ^ 2) by ring] at e7
  have e8 := (vertexMode_bounds p (lc d 0 1 0 (-1)) (2 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hD) hδ (hf 0 1 0 (-1) 2 (by norm_num)) hm a b c).2.2 3 1 2
  rw [show 12 * (2 * D) / δ ^ 2 = (12 * 2) * (D / δ ^ 2) by ring] at e8
  have e9 := (vertexMode_bounds p (lc d 0 0 0 1) (1 * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1) hD) hδ (hf 0 0 0 1 1 (by norm_num)) hm a b c).1 3 1
  rw [show 12 * (1 * D) / δ ^ 2 = (12 * 1) * (D / δ ^ 2) by ring] at e9
  have e10 := (vertexMode_bounds p (lc d 0 (-1 / 2) (1 / 2) (1 / 2)) ((3 / 2) * D) δ (mul_nonneg (by norm_num : (0 : ℝ) ≤ (3 / 2)) hD) hδ (hf 0 (-1 / 2) (1 / 2) (1 / 2) (3 / 2) (by norm_num)) hm a b c).2.1 2 3
  rw [show 12 * ((3 / 2) * D) / δ ^ 2 = (12 * (3 / 2)) * (D / δ ^ 2) by ring] at e10
  have hM0 : 0 ≤ D / δ ^ 2 := by positivity
  unfold vertexWeightF_PAR088
  rw [show 288 * D / δ ^ 2 = 288 * (D / δ ^ 2) by ring]
  generalize D / δ ^ 2 = M at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 hM0 ⊢
  rw [abs_le] at e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 ⊢
  constructor <;> linarith [e0.1, e0.2, e1.1, e1.2, e2.1, e2.2, e3.1, e3.2, e4.1, e4.2, e5.1, e5.2, e6.1, e6.2, e7.1, e7.2, e8.1, e8.2, e9.1, e9.2, e10.1, e10.2]

def zeroRowWeightF_PAR088 (p : V → Fin 4) (g : V → V → ℝ) (a b c : V) : ℝ :=
  internalPairWeight p 0 1 g a b c +
  repeatedPairWeight p 0 1 g a b c +
  repeatedPairWeight p 2 1 g a b c +
  repeatedPairWeight p 3 1 g a b c +
  internalPairWeight p 2 1 g a b c +
  repeatedPairWeight p 2 3 g a b c +
  internalPairWeight p 3 1 g a b c

theorem zeroRowWeightF_PAR088_symmetric (p : V → Fin 4) (g : V → V → ℝ)
    (hs : ∀ a b, g a b = g b a) : TernarySymmetric (zeroRowWeightF_PAR088 p g) := by
  unfold zeroRowWeightF_PAR088
  repeat' first
    | with_reducible apply TernarySymmetric.add
    | with_reducible exact internalPairWeight_symmetric p _ _ g hs
