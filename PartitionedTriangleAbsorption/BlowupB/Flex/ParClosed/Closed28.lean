module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv28
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv28` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR112 : FamilyFacts F_PAR112 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR112 : PaddedInputs.KeevashPaddedSpec F_PAR112 :=
  keevashPaddedSpec_of_certs₈ F_PAR112 familyFacts_PAR112 universalCert_PAR112
    PaddedComponents.completeInverseCert₈_F_PAR112

theorem familyFacts_PAR113 : FamilyFacts F_PAR113 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR113 : PaddedInputs.KeevashPaddedSpec F_PAR113 :=
  keevashPaddedSpec_of_certs₈ F_PAR113 familyFacts_PAR113 universalCert_PAR113
    PaddedComponents.completeInverseCert₈_F_PAR113

theorem familyFacts_PAR114 : FamilyFacts F_PAR114 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR114 : PaddedInputs.KeevashPaddedSpec F_PAR114 :=
  keevashPaddedSpec_of_certs₈ F_PAR114 familyFacts_PAR114 universalCert_PAR114
    PaddedComponents.completeInverseCert₈_F_PAR114

theorem familyFacts_PAR115 : FamilyFacts F_PAR115 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR115 : PaddedInputs.KeevashPaddedSpec F_PAR115 :=
  keevashPaddedSpec_of_certs₈ F_PAR115 familyFacts_PAR115 universalCert_PAR115
    PaddedComponents.completeInverseCert₈_F_PAR115

/-- The relabellings of the PAR families of batch `28`. -/
def CoveredPar28 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR112 ∨ F = permFam σ F_PAR113 ∨ F = permFam σ F_PAR114 ∨ F = permFam σ F_PAR115

theorem keevashPaddedSpec_of_coveredPar28 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar28 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR112
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR113
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR114
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR115

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

