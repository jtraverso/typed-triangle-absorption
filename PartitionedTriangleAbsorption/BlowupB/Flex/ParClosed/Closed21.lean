/-! # `KeevashPaddedSpec` for the PAR families of `Inv21` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR084 : FamilyFacts F_PAR084 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR084 : PaddedInputs.KeevashPaddedSpec F_PAR084 :=
  keevashPaddedSpec_of_certs₈ F_PAR084 familyFacts_PAR084 universalCert_PAR084
    PaddedComponents.completeInverseCert₈_F_PAR084

theorem familyFacts_PAR085 : FamilyFacts F_PAR085 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR085 : PaddedInputs.KeevashPaddedSpec F_PAR085 :=
  keevashPaddedSpec_of_certs₈ F_PAR085 familyFacts_PAR085 universalCert_PAR085
    PaddedComponents.completeInverseCert₈_F_PAR085

theorem familyFacts_PAR086 : FamilyFacts F_PAR086 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR086 : PaddedInputs.KeevashPaddedSpec F_PAR086 :=
