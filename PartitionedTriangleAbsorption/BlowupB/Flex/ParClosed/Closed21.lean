/-- The relabellings of the PAR families of batch `21`. -/
def CoveredPar21 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR084 ∨ F = permFam σ F_PAR085 ∨ F = permFam σ F_PAR086 ∨ F = permFam σ F_PAR087

theorem keevashPaddedSpec_of_coveredPar21 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar21 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR084
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR085
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR086
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR087

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

