    PaddedComponents.completeInverseCert₈_F_PAR067

/-- The relabellings of the PAR families of batch `16`. -/
def CoveredPar16 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR064 ∨ F = permFam σ F_PAR065 ∨ F = permFam σ F_PAR066 ∨ F = permFam σ F_PAR067

theorem keevashPaddedSpec_of_coveredPar16 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar16 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR064
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR065
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR066
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR067

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

