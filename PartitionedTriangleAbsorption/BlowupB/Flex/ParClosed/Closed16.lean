@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv16` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR064 : FamilyFacts F_PAR064 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR064 : PaddedInputs.KeevashPaddedSpec F_PAR064 :=
  keevashPaddedSpec_of_certs₈ F_PAR064 familyFacts_PAR064 universalCert_PAR064
    PaddedComponents.completeInverseCert₈_F_PAR064

theorem familyFacts_PAR065 : FamilyFacts F_PAR065 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR065 : PaddedInputs.KeevashPaddedSpec F_PAR065 :=
  keevashPaddedSpec_of_certs₈ F_PAR065 familyFacts_PAR065 universalCert_PAR065
    PaddedComponents.completeInverseCert₈_F_PAR065

theorem familyFacts_PAR066 : FamilyFacts F_PAR066 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR066 : PaddedInputs.KeevashPaddedSpec F_PAR066 :=
  keevashPaddedSpec_of_certs₈ F_PAR066 familyFacts_PAR066 universalCert_PAR066
    PaddedComponents.completeInverseCert₈_F_PAR066

theorem familyFacts_PAR067 : FamilyFacts F_PAR067 :=
