module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv25
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv25` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR100 : FamilyFacts F_PAR100 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR100 : PaddedInputs.KeevashPaddedSpec F_PAR100 :=
  keevashPaddedSpec_of_certs₈ F_PAR100 familyFacts_PAR100 universalCert_PAR100
    PaddedComponents.completeInverseCert₈_F_PAR100

theorem familyFacts_PAR101 : FamilyFacts F_PAR101 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR101 : PaddedInputs.KeevashPaddedSpec F_PAR101 :=
  keevashPaddedSpec_of_certs₈ F_PAR101 familyFacts_PAR101 universalCert_PAR101
    PaddedComponents.completeInverseCert₈_F_PAR101

theorem familyFacts_PAR102 : FamilyFacts F_PAR102 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR102 : PaddedInputs.KeevashPaddedSpec F_PAR102 :=
  keevashPaddedSpec_of_certs₈ F_PAR102 familyFacts_PAR102 universalCert_PAR102
    PaddedComponents.completeInverseCert₈_F_PAR102

theorem familyFacts_PAR103 : FamilyFacts F_PAR103 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR103 : PaddedInputs.KeevashPaddedSpec F_PAR103 :=
  keevashPaddedSpec_of_certs₈ F_PAR103 familyFacts_PAR103 universalCert_PAR103
    PaddedComponents.completeInverseCert₈_F_PAR103

/-- The relabellings of the PAR families of batch `25`. -/
def CoveredPar25 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR100 ∨ F = permFam σ F_PAR101 ∨ F = permFam σ F_PAR102 ∨ F = permFam σ F_PAR103

theorem keevashPaddedSpec_of_coveredPar25 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar25 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR100
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR101
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR102
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR103

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

