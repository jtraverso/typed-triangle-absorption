module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv61
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv61` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR241 : FamilyFacts F_PAR241 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR241 : PaddedInputs.KeevashPaddedSpec F_PAR241 :=
  keevashPaddedSpec_of_certs₈ F_PAR241 familyFacts_PAR241 universalCert_PAR241
    PaddedComponents.completeInverseCert₈_F_PAR241

theorem familyFacts_PAR242 : FamilyFacts F_PAR242 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR242 : PaddedInputs.KeevashPaddedSpec F_PAR242 :=
  keevashPaddedSpec_of_certs₈ F_PAR242 familyFacts_PAR242 universalCert_PAR242
    PaddedComponents.completeInverseCert₈_F_PAR242

/-- The relabellings of the PAR families of batch `61`. -/
def CoveredPar61 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR241 ∨ F = permFam σ F_PAR242

theorem keevashPaddedSpec_of_coveredPar61 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar61 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR241
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR242

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

#print axioms PartitionedTriangleAbsorption.BlowupB.Flex.Par.keevashPaddedSpec_of_coveredPar61
