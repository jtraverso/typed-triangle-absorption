@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv42` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR168 : FamilyFacts F_PAR168 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR168 : PaddedInputs.KeevashPaddedSpec F_PAR168 :=
  keevashPaddedSpec_of_certs₈ F_PAR168 familyFacts_PAR168 universalCert_PAR168
    PaddedComponents.completeInverseCert₈_F_PAR168

theorem familyFacts_PAR169 : FamilyFacts F_PAR169 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR169 : PaddedInputs.KeevashPaddedSpec F_PAR169 :=
  keevashPaddedSpec_of_certs₈ F_PAR169 familyFacts_PAR169 universalCert_PAR169
    PaddedComponents.completeInverseCert₈_F_PAR169

theorem familyFacts_PAR170 : FamilyFacts F_PAR170 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR170 : PaddedInputs.KeevashPaddedSpec F_PAR170 :=
  keevashPaddedSpec_of_certs₈ F_PAR170 familyFacts_PAR170 universalCert_PAR170
    PaddedComponents.completeInverseCert₈_F_PAR170

theorem familyFacts_PAR171 : FamilyFacts F_PAR171 :=
