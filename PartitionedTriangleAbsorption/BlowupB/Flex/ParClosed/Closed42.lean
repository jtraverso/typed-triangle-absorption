    PaddedComponents.completeInverseCert₈_F_PAR171

/-- The relabellings of the PAR families of batch `42`. -/
def CoveredPar42 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR168 ∨ F = permFam σ F_PAR169 ∨ F = permFam σ F_PAR170 ∨ F = permFam σ F_PAR171

theorem keevashPaddedSpec_of_coveredPar42 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar42 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR168
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR169
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR170
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR171

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

