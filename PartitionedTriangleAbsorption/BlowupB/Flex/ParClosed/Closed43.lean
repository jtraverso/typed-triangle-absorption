/-- The relabellings of the PAR families of batch `43`. -/
def CoveredPar43 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR172 ∨ F = permFam σ F_PAR173 ∨ F = permFam σ F_PAR174 ∨ F = permFam σ F_PAR175

theorem keevashPaddedSpec_of_coveredPar43 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar43 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR172
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR173
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR174
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR175

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

