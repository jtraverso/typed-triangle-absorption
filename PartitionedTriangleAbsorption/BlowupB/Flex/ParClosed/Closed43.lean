/-! # `KeevashPaddedSpec` for the PAR families of `Inv43` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR172 : FamilyFacts F_PAR172 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR172 : PaddedInputs.KeevashPaddedSpec F_PAR172 :=
  keevashPaddedSpec_of_certs₈ F_PAR172 familyFacts_PAR172 universalCert_PAR172
    PaddedComponents.completeInverseCert₈_F_PAR172

theorem familyFacts_PAR173 : FamilyFacts F_PAR173 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR173 : PaddedInputs.KeevashPaddedSpec F_PAR173 :=
  keevashPaddedSpec_of_certs₈ F_PAR173 familyFacts_PAR173 universalCert_PAR173
    PaddedComponents.completeInverseCert₈_F_PAR173

theorem familyFacts_PAR174 : FamilyFacts F_PAR174 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR174 : PaddedInputs.KeevashPaddedSpec F_PAR174 :=
  keevashPaddedSpec_of_certs₈ F_PAR174 familyFacts_PAR174 universalCert_PAR174
    PaddedComponents.completeInverseCert₈_F_PAR174

