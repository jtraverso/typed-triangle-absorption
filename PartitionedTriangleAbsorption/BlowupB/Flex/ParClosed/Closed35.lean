module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv35
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv35` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR140 : FamilyFacts F_PAR140 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR140 : PaddedInputs.KeevashPaddedSpec F_PAR140 :=
  keevashPaddedSpec_of_certs₈ F_PAR140 familyFacts_PAR140 universalCert_PAR140
    PaddedComponents.completeInverseCert₈_F_PAR140

theorem familyFacts_PAR141 : FamilyFacts F_PAR141 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR141 : PaddedInputs.KeevashPaddedSpec F_PAR141 :=
  keevashPaddedSpec_of_certs₈ F_PAR141 familyFacts_PAR141 universalCert_PAR141
    PaddedComponents.completeInverseCert₈_F_PAR141

theorem familyFacts_PAR142 : FamilyFacts F_PAR142 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR142 : PaddedInputs.KeevashPaddedSpec F_PAR142 :=
  keevashPaddedSpec_of_certs₈ F_PAR142 familyFacts_PAR142 universalCert_PAR142
    PaddedComponents.completeInverseCert₈_F_PAR142

theorem familyFacts_PAR143 : FamilyFacts F_PAR143 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR143 : PaddedInputs.KeevashPaddedSpec F_PAR143 :=
  keevashPaddedSpec_of_certs₈ F_PAR143 familyFacts_PAR143 universalCert_PAR143
    PaddedComponents.completeInverseCert₈_F_PAR143

/-- The relabellings of the PAR families of batch `35`. -/
def CoveredPar35 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR140 ∨ F = permFam σ F_PAR141 ∨ F = permFam σ F_PAR142 ∨ F = permFam σ F_PAR143

theorem keevashPaddedSpec_of_coveredPar35 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar35 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR140
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR141
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR142
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR143

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

