module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv69
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv69` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR600 : FamilyFacts F_PAR600 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR600 : PaddedInputs.KeevashPaddedSpec F_PAR600 :=
  keevashPaddedSpec_of_certs₈ F_PAR600 familyFacts_PAR600 universalCert_PAR600
    PaddedComponents.completeInverseCert₈_F_PAR600

theorem familyFacts_PAR601 : FamilyFacts F_PAR601 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR601 : PaddedInputs.KeevashPaddedSpec F_PAR601 :=
  keevashPaddedSpec_of_certs₈ F_PAR601 familyFacts_PAR601 universalCert_PAR601
    PaddedComponents.completeInverseCert₈_F_PAR601

theorem familyFacts_PAR602 : FamilyFacts F_PAR602 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR602 : PaddedInputs.KeevashPaddedSpec F_PAR602 :=
  keevashPaddedSpec_of_certs₈ F_PAR602 familyFacts_PAR602 universalCert_PAR602
    PaddedComponents.completeInverseCert₈_F_PAR602

/-- The relabellings of the PAR families of batch `69`. -/
def CoveredPar69 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR600 ∨ F = permFam σ F_PAR601 ∨ F = permFam σ F_PAR602

theorem keevashPaddedSpec_of_coveredPar69 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar69 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR600
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR601
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR602

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

