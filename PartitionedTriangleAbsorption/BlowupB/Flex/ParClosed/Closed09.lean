/-- The relabellings of the PAR families of batch `09`. -/
def CoveredPar09 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR036 ∨ F = permFam σ F_PAR037 ∨ F = permFam σ F_PAR038 ∨ F = permFam σ F_PAR039

theorem keevashPaddedSpec_of_coveredPar09 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar09 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR036
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR037
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR038
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR039

