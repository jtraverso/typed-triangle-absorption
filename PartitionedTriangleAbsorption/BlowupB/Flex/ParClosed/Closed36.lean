module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv36
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv36` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR144 : FamilyFacts F_PAR144 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR144 : PaddedInputs.KeevashPaddedSpec F_PAR144 :=
  keevashPaddedSpec_of_certs₈ F_PAR144 familyFacts_PAR144 universalCert_PAR144
    PaddedComponents.completeInverseCert₈_F_PAR144

theorem familyFacts_PAR145 : FamilyFacts F_PAR145 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR145 : PaddedInputs.KeevashPaddedSpec F_PAR145 :=
  keevashPaddedSpec_of_certs₈ F_PAR145 familyFacts_PAR145 universalCert_PAR145
    PaddedComponents.completeInverseCert₈_F_PAR145

theorem familyFacts_PAR146 : FamilyFacts F_PAR146 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR146 : PaddedInputs.KeevashPaddedSpec F_PAR146 :=
  keevashPaddedSpec_of_certs₈ F_PAR146 familyFacts_PAR146 universalCert_PAR146
    PaddedComponents.completeInverseCert₈_F_PAR146

theorem familyFacts_PAR147 : FamilyFacts F_PAR147 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR147 : PaddedInputs.KeevashPaddedSpec F_PAR147 :=
  keevashPaddedSpec_of_certs₈ F_PAR147 familyFacts_PAR147 universalCert_PAR147
    PaddedComponents.completeInverseCert₈_F_PAR147

/-- The relabellings of the PAR families of batch `36`. -/
def CoveredPar36 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR144 ∨ F = permFam σ F_PAR145 ∨ F = permFam σ F_PAR146 ∨ F = permFam σ F_PAR147

theorem keevashPaddedSpec_of_coveredPar36 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar36 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR144
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR145
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR146
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR147

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

