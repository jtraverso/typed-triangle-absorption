    PaddedComponents.completeInverseCert₈_F_PAR155

/-- The relabellings of the PAR families of batch `38`. -/
def CoveredPar38 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR152 ∨ F = permFam σ F_PAR153 ∨ F = permFam σ F_PAR154 ∨ F = permFam σ F_PAR155

theorem keevashPaddedSpec_of_coveredPar38 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar38 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR152
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR153
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR154
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR155

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

