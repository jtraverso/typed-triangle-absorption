@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv38` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR152 : FamilyFacts F_PAR152 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR152 : PaddedInputs.KeevashPaddedSpec F_PAR152 :=
  keevashPaddedSpec_of_certs₈ F_PAR152 familyFacts_PAR152 universalCert_PAR152
    PaddedComponents.completeInverseCert₈_F_PAR152

theorem familyFacts_PAR153 : FamilyFacts F_PAR153 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR153 : PaddedInputs.KeevashPaddedSpec F_PAR153 :=
  keevashPaddedSpec_of_certs₈ F_PAR153 familyFacts_PAR153 universalCert_PAR153
    PaddedComponents.completeInverseCert₈_F_PAR153

theorem familyFacts_PAR154 : FamilyFacts F_PAR154 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR154 : PaddedInputs.KeevashPaddedSpec F_PAR154 :=
  keevashPaddedSpec_of_certs₈ F_PAR154 familyFacts_PAR154 universalCert_PAR154
    PaddedComponents.completeInverseCert₈_F_PAR154

theorem familyFacts_PAR155 : FamilyFacts F_PAR155 :=
