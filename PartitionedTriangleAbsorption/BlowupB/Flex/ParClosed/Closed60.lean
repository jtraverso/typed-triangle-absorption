/-- The relabellings of the PAR families of batch `60`. -/
def CoveredPar60 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR237 ∨ F = permFam σ F_PAR238 ∨ F = permFam σ F_PAR239 ∨ F = permFam σ F_PAR240

theorem keevashPaddedSpec_of_coveredPar60 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar60 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR237
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR238
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR239
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR240

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

