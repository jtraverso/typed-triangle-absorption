/-! # `KeevashPaddedSpec` for the PAR families of `Inv60` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR237 : FamilyFacts F_PAR237 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR237 : PaddedInputs.KeevashPaddedSpec F_PAR237 :=
  keevashPaddedSpec_of_certs₈ F_PAR237 familyFacts_PAR237 universalCert_PAR237
    PaddedComponents.completeInverseCert₈_F_PAR237

theorem familyFacts_PAR238 : FamilyFacts F_PAR238 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR238 : PaddedInputs.KeevashPaddedSpec F_PAR238 :=
  keevashPaddedSpec_of_certs₈ F_PAR238 familyFacts_PAR238 universalCert_PAR238
    PaddedComponents.completeInverseCert₈_F_PAR238

theorem familyFacts_PAR239 : FamilyFacts F_PAR239 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR239 : PaddedInputs.KeevashPaddedSpec F_PAR239 :=
  keevashPaddedSpec_of_certs₈ F_PAR239 familyFacts_PAR239 universalCert_PAR239
    PaddedComponents.completeInverseCert₈_F_PAR239

