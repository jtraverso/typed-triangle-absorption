module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv50
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv50` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR200 : FamilyFacts F_PAR200 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR200 : PaddedInputs.KeevashPaddedSpec F_PAR200 :=
  keevashPaddedSpec_of_certs₈ F_PAR200 familyFacts_PAR200 universalCert_PAR200
    PaddedComponents.completeInverseCert₈_F_PAR200

theorem familyFacts_PAR201 : FamilyFacts F_PAR201 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR201 : PaddedInputs.KeevashPaddedSpec F_PAR201 :=
  keevashPaddedSpec_of_certs₈ F_PAR201 familyFacts_PAR201 universalCert_PAR201
    PaddedComponents.completeInverseCert₈_F_PAR201

theorem familyFacts_PAR202 : FamilyFacts F_PAR202 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR202 : PaddedInputs.KeevashPaddedSpec F_PAR202 :=
  keevashPaddedSpec_of_certs₈ F_PAR202 familyFacts_PAR202 universalCert_PAR202
    PaddedComponents.completeInverseCert₈_F_PAR202

theorem familyFacts_PAR203 : FamilyFacts F_PAR203 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR203 : PaddedInputs.KeevashPaddedSpec F_PAR203 :=
  keevashPaddedSpec_of_certs₈ F_PAR203 familyFacts_PAR203 universalCert_PAR203
    PaddedComponents.completeInverseCert₈_F_PAR203

/-- The relabellings of the PAR families of batch `50`. -/
def CoveredPar50 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR200 ∨ F = permFam σ F_PAR201 ∨ F = permFam σ F_PAR202 ∨ F = permFam σ F_PAR203

theorem keevashPaddedSpec_of_coveredPar50 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar50 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR200
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR201
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR202
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR203

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

#print axioms PartitionedTriangleAbsorption.BlowupB.Flex.Par.keevashPaddedSpec_of_coveredPar50
