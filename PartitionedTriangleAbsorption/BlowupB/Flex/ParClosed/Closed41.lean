/-- The relabellings of the PAR families of batch `41`. -/
def CoveredPar41 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR164 ∨ F = permFam σ F_PAR165 ∨ F = permFam σ F_PAR166 ∨ F = permFam σ F_PAR167

theorem keevashPaddedSpec_of_coveredPar41 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar41 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR164
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR165
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR166
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR167

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

