@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv41` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR164 : FamilyFacts F_PAR164 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR164 : PaddedInputs.KeevashPaddedSpec F_PAR164 :=
  keevashPaddedSpec_of_certs₈ F_PAR164 familyFacts_PAR164 universalCert_PAR164
    PaddedComponents.completeInverseCert₈_F_PAR164

theorem familyFacts_PAR165 : FamilyFacts F_PAR165 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR165 : PaddedInputs.KeevashPaddedSpec F_PAR165 :=
  keevashPaddedSpec_of_certs₈ F_PAR165 familyFacts_PAR165 universalCert_PAR165
    PaddedComponents.completeInverseCert₈_F_PAR165

theorem familyFacts_PAR166 : FamilyFacts F_PAR166 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR166 : PaddedInputs.KeevashPaddedSpec F_PAR166 :=
  keevashPaddedSpec_of_certs₈ F_PAR166 familyFacts_PAR166 universalCert_PAR166
    PaddedComponents.completeInverseCert₈_F_PAR166

