module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv62
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv62` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR500 : FamilyFacts F_PAR500 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR500 : PaddedInputs.KeevashPaddedSpec F_PAR500 :=
  keevashPaddedSpec_of_certs₈ F_PAR500 familyFacts_PAR500 universalCert_PAR500
    PaddedComponents.completeInverseCert₈_F_PAR500

theorem familyFacts_PAR501 : FamilyFacts F_PAR501 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR501 : PaddedInputs.KeevashPaddedSpec F_PAR501 :=
  keevashPaddedSpec_of_certs₈ F_PAR501 familyFacts_PAR501 universalCert_PAR501
    PaddedComponents.completeInverseCert₈_F_PAR501

theorem familyFacts_PAR502 : FamilyFacts F_PAR502 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR502 : PaddedInputs.KeevashPaddedSpec F_PAR502 :=
  keevashPaddedSpec_of_certs₈ F_PAR502 familyFacts_PAR502 universalCert_PAR502
    PaddedComponents.completeInverseCert₈_F_PAR502

theorem familyFacts_PAR503 : FamilyFacts F_PAR503 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR503 : PaddedInputs.KeevashPaddedSpec F_PAR503 :=
  keevashPaddedSpec_of_certs₈ F_PAR503 familyFacts_PAR503 universalCert_PAR503
    PaddedComponents.completeInverseCert₈_F_PAR503

/-- The relabellings of the PAR families of batch `62`. -/
def CoveredPar62 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR500 ∨ F = permFam σ F_PAR501 ∨ F = permFam σ F_PAR502 ∨ F = permFam σ F_PAR503

theorem keevashPaddedSpec_of_coveredPar62 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar62 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR500
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR501
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR502
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR503

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

#print axioms PartitionedTriangleAbsorption.BlowupB.Flex.Par.keevashPaddedSpec_of_coveredPar62
