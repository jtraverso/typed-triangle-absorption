module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv40
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv40` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR160 : FamilyFacts F_PAR160 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR160 : PaddedInputs.KeevashPaddedSpec F_PAR160 :=
  keevashPaddedSpec_of_certs₈ F_PAR160 familyFacts_PAR160 universalCert_PAR160
    PaddedComponents.completeInverseCert₈_F_PAR160

theorem familyFacts_PAR161 : FamilyFacts F_PAR161 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR161 : PaddedInputs.KeevashPaddedSpec F_PAR161 :=
  keevashPaddedSpec_of_certs₈ F_PAR161 familyFacts_PAR161 universalCert_PAR161
    PaddedComponents.completeInverseCert₈_F_PAR161

theorem familyFacts_PAR162 : FamilyFacts F_PAR162 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR162 : PaddedInputs.KeevashPaddedSpec F_PAR162 :=
  keevashPaddedSpec_of_certs₈ F_PAR162 familyFacts_PAR162 universalCert_PAR162
    PaddedComponents.completeInverseCert₈_F_PAR162

theorem familyFacts_PAR163 : FamilyFacts F_PAR163 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR163 : PaddedInputs.KeevashPaddedSpec F_PAR163 :=
  keevashPaddedSpec_of_certs₈ F_PAR163 familyFacts_PAR163 universalCert_PAR163
    PaddedComponents.completeInverseCert₈_F_PAR163

/-- The relabellings of the PAR families of batch `40`. -/
def CoveredPar40 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR160 ∨ F = permFam σ F_PAR161 ∨ F = permFam σ F_PAR162 ∨ F = permFam σ F_PAR163

theorem keevashPaddedSpec_of_coveredPar40 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar40 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR160
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR161
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR162
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR163

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

