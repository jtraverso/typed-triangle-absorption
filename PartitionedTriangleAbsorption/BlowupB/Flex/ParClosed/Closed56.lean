module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv56
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv56` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR224 : FamilyFacts F_PAR224 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR224 : PaddedInputs.KeevashPaddedSpec F_PAR224 :=
  keevashPaddedSpec_of_certs₈ F_PAR224 familyFacts_PAR224 universalCert_PAR224
    PaddedComponents.completeInverseCert₈_F_PAR224

theorem familyFacts_PAR225 : FamilyFacts F_PAR225 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR225 : PaddedInputs.KeevashPaddedSpec F_PAR225 :=
  keevashPaddedSpec_of_certs₈ F_PAR225 familyFacts_PAR225 universalCert_PAR225
    PaddedComponents.completeInverseCert₈_F_PAR225

theorem familyFacts_PAR226 : FamilyFacts F_PAR226 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR226 : PaddedInputs.KeevashPaddedSpec F_PAR226 :=
  keevashPaddedSpec_of_certs₈ F_PAR226 familyFacts_PAR226 universalCert_PAR226
    PaddedComponents.completeInverseCert₈_F_PAR226

theorem familyFacts_PAR227 : FamilyFacts F_PAR227 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR227 : PaddedInputs.KeevashPaddedSpec F_PAR227 :=
  keevashPaddedSpec_of_certs₈ F_PAR227 familyFacts_PAR227 universalCert_PAR227
    PaddedComponents.completeInverseCert₈_F_PAR227

/-- The relabellings of the PAR families of batch `56`. -/
def CoveredPar56 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR224 ∨ F = permFam σ F_PAR225 ∨ F = permFam σ F_PAR226 ∨ F = permFam σ F_PAR227

theorem keevashPaddedSpec_of_coveredPar56 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar56 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR224
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR225
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR226
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR227

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

