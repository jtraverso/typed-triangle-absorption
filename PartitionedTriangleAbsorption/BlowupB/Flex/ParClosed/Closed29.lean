open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR116 : FamilyFacts F_PAR116 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR116 : PaddedInputs.KeevashPaddedSpec F_PAR116 :=
  keevashPaddedSpec_of_certs₈ F_PAR116 familyFacts_PAR116 universalCert_PAR116
    PaddedComponents.completeInverseCert₈_F_PAR116

theorem familyFacts_PAR117 : FamilyFacts F_PAR117 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR117 : PaddedInputs.KeevashPaddedSpec F_PAR117 :=
  keevashPaddedSpec_of_certs₈ F_PAR117 familyFacts_PAR117 universalCert_PAR117
