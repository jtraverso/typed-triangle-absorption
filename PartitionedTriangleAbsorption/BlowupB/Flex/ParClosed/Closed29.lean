/-- The relabellings of the PAR families of batch `29`. -/
def CoveredPar29 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR116 ∨ F = permFam σ F_PAR117 ∨ F = permFam σ F_PAR118 ∨ F = permFam σ F_PAR119

theorem keevashPaddedSpec_of_coveredPar29 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar29 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR116
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR117
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR118
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR119

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

