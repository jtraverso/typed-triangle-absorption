module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv51
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv51` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR204 : FamilyFacts F_PAR204 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR204 : PaddedInputs.KeevashPaddedSpec F_PAR204 :=
  keevashPaddedSpec_of_certs₈ F_PAR204 familyFacts_PAR204 universalCert_PAR204
    PaddedComponents.completeInverseCert₈_F_PAR204

theorem familyFacts_PAR205 : FamilyFacts F_PAR205 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR205 : PaddedInputs.KeevashPaddedSpec F_PAR205 :=
  keevashPaddedSpec_of_certs₈ F_PAR205 familyFacts_PAR205 universalCert_PAR205
    PaddedComponents.completeInverseCert₈_F_PAR205

theorem familyFacts_PAR206 : FamilyFacts F_PAR206 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR206 : PaddedInputs.KeevashPaddedSpec F_PAR206 :=
  keevashPaddedSpec_of_certs₈ F_PAR206 familyFacts_PAR206 universalCert_PAR206
    PaddedComponents.completeInverseCert₈_F_PAR206

theorem familyFacts_PAR207 : FamilyFacts F_PAR207 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR207 : PaddedInputs.KeevashPaddedSpec F_PAR207 :=
  keevashPaddedSpec_of_certs₈ F_PAR207 familyFacts_PAR207 universalCert_PAR207
    PaddedComponents.completeInverseCert₈_F_PAR207

/-- The relabellings of the PAR families of batch `51`. -/
def CoveredPar51 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR204 ∨ F = permFam σ F_PAR205 ∨ F = permFam σ F_PAR206 ∨ F = permFam σ F_PAR207

theorem keevashPaddedSpec_of_coveredPar51 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar51 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR204
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR205
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR206
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR207

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

