/-- The relabellings of the PAR families of batch `13`. -/
def CoveredPar13 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR052 ∨ F = permFam σ F_PAR053 ∨ F = permFam σ F_PAR054 ∨ F = permFam σ F_PAR055

theorem keevashPaddedSpec_of_coveredPar13 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar13 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR052
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR053
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR054
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR055

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

