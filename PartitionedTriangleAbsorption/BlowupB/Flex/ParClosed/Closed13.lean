/-! # `KeevashPaddedSpec` for the PAR families of `Inv13` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR052 : FamilyFacts F_PAR052 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR052 : PaddedInputs.KeevashPaddedSpec F_PAR052 :=
  keevashPaddedSpec_of_certs₈ F_PAR052 familyFacts_PAR052 universalCert_PAR052
    PaddedComponents.completeInverseCert₈_F_PAR052

theorem familyFacts_PAR053 : FamilyFacts F_PAR053 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR053 : PaddedInputs.KeevashPaddedSpec F_PAR053 :=
  keevashPaddedSpec_of_certs₈ F_PAR053 familyFacts_PAR053 universalCert_PAR053
    PaddedComponents.completeInverseCert₈_F_PAR053

theorem familyFacts_PAR054 : FamilyFacts F_PAR054 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR054 : PaddedInputs.KeevashPaddedSpec F_PAR054 :=
  keevashPaddedSpec_of_certs₈ F_PAR054 familyFacts_PAR054 universalCert_PAR054
    PaddedComponents.completeInverseCert₈_F_PAR054

theorem familyFacts_PAR055 : FamilyFacts F_PAR055 :=
