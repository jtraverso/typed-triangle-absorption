/-! # `KeevashPaddedSpec` for the PAR families of `Inv63` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR504 : FamilyFacts F_PAR504 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR504 : PaddedInputs.KeevashPaddedSpec F_PAR504 :=
  keevashPaddedSpec_of_certs₈ F_PAR504 familyFacts_PAR504 universalCert_PAR504
    PaddedComponents.completeInverseCert₈_F_PAR504

theorem familyFacts_PAR505 : FamilyFacts F_PAR505 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR505 : PaddedInputs.KeevashPaddedSpec F_PAR505 :=
  keevashPaddedSpec_of_certs₈ F_PAR505 familyFacts_PAR505 universalCert_PAR505
