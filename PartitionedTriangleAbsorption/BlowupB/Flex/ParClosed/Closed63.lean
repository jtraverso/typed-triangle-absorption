/-- The relabellings of the PAR families of batch `63`. -/
def CoveredPar63 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR504 ∨ F = permFam σ F_PAR505 ∨ F = permFam σ F_PAR506 ∨ F = permFam σ F_PAR507

theorem keevashPaddedSpec_of_coveredPar63 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar63 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR504
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR505
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR506
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR507

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

