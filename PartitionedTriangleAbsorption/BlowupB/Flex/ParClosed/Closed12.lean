/-- The relabellings of the PAR families of batch `12`. -/
def CoveredPar12 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR048 ∨ F = permFam σ F_PAR049 ∨ F = permFam σ F_PAR050 ∨ F = permFam σ F_PAR051

theorem keevashPaddedSpec_of_coveredPar12 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar12 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR048
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR049
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR050
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR051

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

