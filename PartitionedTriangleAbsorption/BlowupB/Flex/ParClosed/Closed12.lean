/-! # `KeevashPaddedSpec` for the PAR families of `Inv12` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR048 : FamilyFacts F_PAR048 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR048 : PaddedInputs.KeevashPaddedSpec F_PAR048 :=
  keevashPaddedSpec_of_certs₈ F_PAR048 familyFacts_PAR048 universalCert_PAR048
    PaddedComponents.completeInverseCert₈_F_PAR048

theorem familyFacts_PAR049 : FamilyFacts F_PAR049 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR049 : PaddedInputs.KeevashPaddedSpec F_PAR049 :=
  keevashPaddedSpec_of_certs₈ F_PAR049 familyFacts_PAR049 universalCert_PAR049
    PaddedComponents.completeInverseCert₈_F_PAR049

theorem familyFacts_PAR050 : FamilyFacts F_PAR050 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR050 : PaddedInputs.KeevashPaddedSpec F_PAR050 :=
  keevashPaddedSpec_of_certs₈ F_PAR050 familyFacts_PAR050 universalCert_PAR050
    PaddedComponents.completeInverseCert₈_F_PAR050

theorem familyFacts_PAR051 : FamilyFacts F_PAR051 :=
