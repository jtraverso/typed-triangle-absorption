module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv20
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv20` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR080 : FamilyFacts F_PAR080 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR080 : PaddedInputs.KeevashPaddedSpec F_PAR080 :=
  keevashPaddedSpec_of_certs₈ F_PAR080 familyFacts_PAR080 universalCert_PAR080
    PaddedComponents.completeInverseCert₈_F_PAR080

theorem familyFacts_PAR081 : FamilyFacts F_PAR081 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR081 : PaddedInputs.KeevashPaddedSpec F_PAR081 :=
  keevashPaddedSpec_of_certs₈ F_PAR081 familyFacts_PAR081 universalCert_PAR081
    PaddedComponents.completeInverseCert₈_F_PAR081

theorem familyFacts_PAR082 : FamilyFacts F_PAR082 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR082 : PaddedInputs.KeevashPaddedSpec F_PAR082 :=
  keevashPaddedSpec_of_certs₈ F_PAR082 familyFacts_PAR082 universalCert_PAR082
    PaddedComponents.completeInverseCert₈_F_PAR082

theorem familyFacts_PAR083 : FamilyFacts F_PAR083 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR083 : PaddedInputs.KeevashPaddedSpec F_PAR083 :=
  keevashPaddedSpec_of_certs₈ F_PAR083 familyFacts_PAR083 universalCert_PAR083
    PaddedComponents.completeInverseCert₈_F_PAR083

/-- The relabellings of the PAR families of batch `20`. -/
def CoveredPar20 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR080 ∨ F = permFam σ F_PAR081 ∨ F = permFam σ F_PAR082 ∨ F = permFam σ F_PAR083

theorem keevashPaddedSpec_of_coveredPar20 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar20 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR080
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR081
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR082
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR083

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

