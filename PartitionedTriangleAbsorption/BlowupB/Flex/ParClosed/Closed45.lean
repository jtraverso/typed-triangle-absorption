module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv45
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv45` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR180 : FamilyFacts F_PAR180 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR180 : PaddedInputs.KeevashPaddedSpec F_PAR180 :=
  keevashPaddedSpec_of_certs₈ F_PAR180 familyFacts_PAR180 universalCert_PAR180
    PaddedComponents.completeInverseCert₈_F_PAR180

theorem familyFacts_PAR181 : FamilyFacts F_PAR181 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR181 : PaddedInputs.KeevashPaddedSpec F_PAR181 :=
  keevashPaddedSpec_of_certs₈ F_PAR181 familyFacts_PAR181 universalCert_PAR181
    PaddedComponents.completeInverseCert₈_F_PAR181

theorem familyFacts_PAR182 : FamilyFacts F_PAR182 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR182 : PaddedInputs.KeevashPaddedSpec F_PAR182 :=
  keevashPaddedSpec_of_certs₈ F_PAR182 familyFacts_PAR182 universalCert_PAR182
    PaddedComponents.completeInverseCert₈_F_PAR182

theorem familyFacts_PAR183 : FamilyFacts F_PAR183 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR183 : PaddedInputs.KeevashPaddedSpec F_PAR183 :=
  keevashPaddedSpec_of_certs₈ F_PAR183 familyFacts_PAR183 universalCert_PAR183
    PaddedComponents.completeInverseCert₈_F_PAR183

/-- The relabellings of the PAR families of batch `45`. -/
def CoveredPar45 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR180 ∨ F = permFam σ F_PAR181 ∨ F = permFam σ F_PAR182 ∨ F = permFam σ F_PAR183

theorem keevashPaddedSpec_of_coveredPar45 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar45 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR180
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR181
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR182
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR183

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

