/-! # `KeevashPaddedSpec` for the PAR families of `Inv44` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR176 : FamilyFacts F_PAR176 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR176 : PaddedInputs.KeevashPaddedSpec F_PAR176 :=
  keevashPaddedSpec_of_certs₈ F_PAR176 familyFacts_PAR176 universalCert_PAR176
    PaddedComponents.completeInverseCert₈_F_PAR176

theorem familyFacts_PAR177 : FamilyFacts F_PAR177 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR177 : PaddedInputs.KeevashPaddedSpec F_PAR177 :=
  keevashPaddedSpec_of_certs₈ F_PAR177 familyFacts_PAR177 universalCert_PAR177
    PaddedComponents.completeInverseCert₈_F_PAR177

theorem familyFacts_PAR178 : FamilyFacts F_PAR178 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR178 : PaddedInputs.KeevashPaddedSpec F_PAR178 :=
