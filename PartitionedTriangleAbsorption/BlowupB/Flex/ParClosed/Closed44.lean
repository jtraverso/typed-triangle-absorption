/-- The relabellings of the PAR families of batch `44`. -/
def CoveredPar44 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR176 ∨ F = permFam σ F_PAR177 ∨ F = permFam σ F_PAR178 ∨ F = permFam σ F_PAR179

theorem keevashPaddedSpec_of_coveredPar44 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar44 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR176
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR177
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR178
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR179

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

