module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv31
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv31` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR124 : FamilyFacts F_PAR124 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR124 : PaddedInputs.KeevashPaddedSpec F_PAR124 :=
  keevashPaddedSpec_of_certs₈ F_PAR124 familyFacts_PAR124 universalCert_PAR124
    PaddedComponents.completeInverseCert₈_F_PAR124

theorem familyFacts_PAR125 : FamilyFacts F_PAR125 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR125 : PaddedInputs.KeevashPaddedSpec F_PAR125 :=
  keevashPaddedSpec_of_certs₈ F_PAR125 familyFacts_PAR125 universalCert_PAR125
    PaddedComponents.completeInverseCert₈_F_PAR125

theorem familyFacts_PAR126 : FamilyFacts F_PAR126 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR126 : PaddedInputs.KeevashPaddedSpec F_PAR126 :=
  keevashPaddedSpec_of_certs₈ F_PAR126 familyFacts_PAR126 universalCert_PAR126
    PaddedComponents.completeInverseCert₈_F_PAR126

theorem familyFacts_PAR127 : FamilyFacts F_PAR127 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR127 : PaddedInputs.KeevashPaddedSpec F_PAR127 :=
  keevashPaddedSpec_of_certs₈ F_PAR127 familyFacts_PAR127 universalCert_PAR127
    PaddedComponents.completeInverseCert₈_F_PAR127

/-- The relabellings of the PAR families of batch `31`. -/
def CoveredPar31 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR124 ∨ F = permFam σ F_PAR125 ∨ F = permFam σ F_PAR126 ∨ F = permFam σ F_PAR127

theorem keevashPaddedSpec_of_coveredPar31 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar31 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR124
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR125
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR126
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR127

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

