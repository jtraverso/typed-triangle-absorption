module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv37
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv37` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR148 : FamilyFacts F_PAR148 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR148 : PaddedInputs.KeevashPaddedSpec F_PAR148 :=
  keevashPaddedSpec_of_certs₈ F_PAR148 familyFacts_PAR148 universalCert_PAR148
    PaddedComponents.completeInverseCert₈_F_PAR148

theorem familyFacts_PAR149 : FamilyFacts F_PAR149 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR149 : PaddedInputs.KeevashPaddedSpec F_PAR149 :=
  keevashPaddedSpec_of_certs₈ F_PAR149 familyFacts_PAR149 universalCert_PAR149
    PaddedComponents.completeInverseCert₈_F_PAR149

theorem familyFacts_PAR150 : FamilyFacts F_PAR150 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR150 : PaddedInputs.KeevashPaddedSpec F_PAR150 :=
  keevashPaddedSpec_of_certs₈ F_PAR150 familyFacts_PAR150 universalCert_PAR150
    PaddedComponents.completeInverseCert₈_F_PAR150

theorem familyFacts_PAR151 : FamilyFacts F_PAR151 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR151 : PaddedInputs.KeevashPaddedSpec F_PAR151 :=
  keevashPaddedSpec_of_certs₈ F_PAR151 familyFacts_PAR151 universalCert_PAR151
    PaddedComponents.completeInverseCert₈_F_PAR151

/-- The relabellings of the PAR families of batch `37`. -/
def CoveredPar37 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR148 ∨ F = permFam σ F_PAR149 ∨ F = permFam σ F_PAR150 ∨ F = permFam σ F_PAR151

theorem keevashPaddedSpec_of_coveredPar37 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar37 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR148
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR149
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR150
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR151

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

