theorem familyFacts_PAR096 : FamilyFacts F_PAR096 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR096 : PaddedInputs.KeevashPaddedSpec F_PAR096 :=
  keevashPaddedSpec_of_certs₈ F_PAR096 familyFacts_PAR096 universalCert_PAR096
    PaddedComponents.completeInverseCert₈_F_PAR096

theorem familyFacts_PAR097 : FamilyFacts F_PAR097 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR097 : PaddedInputs.KeevashPaddedSpec F_PAR097 :=
  keevashPaddedSpec_of_certs₈ F_PAR097 familyFacts_PAR097 universalCert_PAR097
