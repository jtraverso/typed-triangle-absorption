/-- The relabellings of the PAR families of batch `24`. -/
def CoveredPar24 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR096 ∨ F = permFam σ F_PAR097 ∨ F = permFam σ F_PAR098 ∨ F = permFam σ F_PAR099

theorem keevashPaddedSpec_of_coveredPar24 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar24 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR096
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR097
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR098
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR099

