theorem familyFacts_PAR072 : FamilyFacts F_PAR072 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR072 : PaddedInputs.KeevashPaddedSpec F_PAR072 :=
  keevashPaddedSpec_of_certs₈ F_PAR072 familyFacts_PAR072 universalCert_PAR072
    PaddedComponents.completeInverseCert₈_F_PAR072

