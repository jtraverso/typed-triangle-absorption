/-- The relabellings of the PAR families of batch `18`. -/
def CoveredPar18 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR072 ∨ F = permFam σ F_PAR073 ∨ F = permFam σ F_PAR074 ∨ F = permFam σ F_PAR075

theorem keevashPaddedSpec_of_coveredPar18 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar18 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR072
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR073
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR074
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR075

