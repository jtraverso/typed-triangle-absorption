module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv57
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv57` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR228 : FamilyFacts F_PAR228 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR228 : PaddedInputs.KeevashPaddedSpec F_PAR228 :=
  keevashPaddedSpec_of_certs₈ F_PAR228 familyFacts_PAR228 universalCert_PAR228
    PaddedComponents.completeInverseCert₈_F_PAR228

theorem familyFacts_PAR229 : FamilyFacts F_PAR229 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR229 : PaddedInputs.KeevashPaddedSpec F_PAR229 :=
  keevashPaddedSpec_of_certs₈ F_PAR229 familyFacts_PAR229 universalCert_PAR229
    PaddedComponents.completeInverseCert₈_F_PAR229

theorem familyFacts_PAR230 : FamilyFacts F_PAR230 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR230 : PaddedInputs.KeevashPaddedSpec F_PAR230 :=
  keevashPaddedSpec_of_certs₈ F_PAR230 familyFacts_PAR230 universalCert_PAR230
    PaddedComponents.completeInverseCert₈_F_PAR230

theorem familyFacts_PAR231 : FamilyFacts F_PAR231 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR231 : PaddedInputs.KeevashPaddedSpec F_PAR231 :=
  keevashPaddedSpec_of_certs₈ F_PAR231 familyFacts_PAR231 universalCert_PAR231
    PaddedComponents.completeInverseCert₈_F_PAR231

/-- The relabellings of the PAR families of batch `57`. -/
def CoveredPar57 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR228 ∨ F = permFam σ F_PAR229 ∨ F = permFam σ F_PAR230 ∨ F = permFam σ F_PAR231

theorem keevashPaddedSpec_of_coveredPar57 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar57 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR228
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR229
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR230
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR231

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

