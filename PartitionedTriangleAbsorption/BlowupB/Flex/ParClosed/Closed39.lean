/-- The relabellings of the PAR families of batch `39`. -/
def CoveredPar39 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR156 ∨ F = permFam σ F_PAR157 ∨ F = permFam σ F_PAR158 ∨ F = permFam σ F_PAR159

theorem keevashPaddedSpec_of_coveredPar39 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar39 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR156
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR157
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR158
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR159

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

