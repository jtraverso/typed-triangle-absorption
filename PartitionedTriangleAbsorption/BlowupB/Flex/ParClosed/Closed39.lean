/-! # `KeevashPaddedSpec` for the PAR families of `Inv39` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR156 : FamilyFacts F_PAR156 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR156 : PaddedInputs.KeevashPaddedSpec F_PAR156 :=
  keevashPaddedSpec_of_certs₈ F_PAR156 familyFacts_PAR156 universalCert_PAR156
    PaddedComponents.completeInverseCert₈_F_PAR156

theorem familyFacts_PAR157 : FamilyFacts F_PAR157 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR157 : PaddedInputs.KeevashPaddedSpec F_PAR157 :=
  keevashPaddedSpec_of_certs₈ F_PAR157 familyFacts_PAR157 universalCert_PAR157
    PaddedComponents.completeInverseCert₈_F_PAR157

theorem familyFacts_PAR158 : FamilyFacts F_PAR158 :=
