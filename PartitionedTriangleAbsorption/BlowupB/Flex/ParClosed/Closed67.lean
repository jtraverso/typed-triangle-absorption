module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv67
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv67` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR520 : FamilyFacts F_PAR520 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR520 : PaddedInputs.KeevashPaddedSpec F_PAR520 :=
  keevashPaddedSpec_of_certs₈ F_PAR520 familyFacts_PAR520 universalCert_PAR520
    PaddedComponents.completeInverseCert₈_F_PAR520

theorem familyFacts_PAR521 : FamilyFacts F_PAR521 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR521 : PaddedInputs.KeevashPaddedSpec F_PAR521 :=
  keevashPaddedSpec_of_certs₈ F_PAR521 familyFacts_PAR521 universalCert_PAR521
    PaddedComponents.completeInverseCert₈_F_PAR521

theorem familyFacts_PAR522 : FamilyFacts F_PAR522 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR522 : PaddedInputs.KeevashPaddedSpec F_PAR522 :=
  keevashPaddedSpec_of_certs₈ F_PAR522 familyFacts_PAR522 universalCert_PAR522
    PaddedComponents.completeInverseCert₈_F_PAR522

theorem familyFacts_PAR523 : FamilyFacts F_PAR523 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR523 : PaddedInputs.KeevashPaddedSpec F_PAR523 :=
  keevashPaddedSpec_of_certs₈ F_PAR523 familyFacts_PAR523 universalCert_PAR523
    PaddedComponents.completeInverseCert₈_F_PAR523

/-- The relabellings of the PAR families of batch `67`. -/
def CoveredPar67 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR520 ∨ F = permFam σ F_PAR521 ∨ F = permFam σ F_PAR522 ∨ F = permFam σ F_PAR523

theorem keevashPaddedSpec_of_coveredPar67 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar67 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR520
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR521
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR522
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR523

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

