/-! # `KeevashPaddedSpec` for the PAR families of `Inv66` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR516 : FamilyFacts F_PAR516 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR516 : PaddedInputs.KeevashPaddedSpec F_PAR516 :=
  keevashPaddedSpec_of_certs₈ F_PAR516 familyFacts_PAR516 universalCert_PAR516
    PaddedComponents.completeInverseCert₈_F_PAR516

theorem familyFacts_PAR517 : FamilyFacts F_PAR517 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR517 : PaddedInputs.KeevashPaddedSpec F_PAR517 :=
  keevashPaddedSpec_of_certs₈ F_PAR517 familyFacts_PAR517 universalCert_PAR517
    PaddedComponents.completeInverseCert₈_F_PAR517

theorem familyFacts_PAR518 : FamilyFacts F_PAR518 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR518 : PaddedInputs.KeevashPaddedSpec F_PAR518 :=
  keevashPaddedSpec_of_certs₈ F_PAR518 familyFacts_PAR518 universalCert_PAR518
