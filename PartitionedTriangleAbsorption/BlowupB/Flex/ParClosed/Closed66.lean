/-- The relabellings of the PAR families of batch `66`. -/
def CoveredPar66 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR516 ∨ F = permFam σ F_PAR517 ∨ F = permFam σ F_PAR518 ∨ F = permFam σ F_PAR519

theorem keevashPaddedSpec_of_coveredPar66 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar66 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR516
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR517
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR518
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR519

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

