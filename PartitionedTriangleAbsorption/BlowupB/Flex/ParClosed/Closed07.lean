/-! # `KeevashPaddedSpec` for the PAR families of `Inv07` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR028 : FamilyFacts F_PAR028 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR028 : PaddedInputs.KeevashPaddedSpec F_PAR028 :=
  keevashPaddedSpec_of_certs₈ F_PAR028 familyFacts_PAR028 universalCert_PAR028
    PaddedComponents.completeInverseCert₈_F_PAR028

theorem familyFacts_PAR029 : FamilyFacts F_PAR029 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR029 : PaddedInputs.KeevashPaddedSpec F_PAR029 :=
  keevashPaddedSpec_of_certs₈ F_PAR029 familyFacts_PAR029 universalCert_PAR029
    PaddedComponents.completeInverseCert₈_F_PAR029

theorem familyFacts_PAR030 : FamilyFacts F_PAR030 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR030 : PaddedInputs.KeevashPaddedSpec F_PAR030 :=
  keevashPaddedSpec_of_certs₈ F_PAR030 familyFacts_PAR030 universalCert_PAR030
