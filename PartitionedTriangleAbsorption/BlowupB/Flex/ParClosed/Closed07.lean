/-- The relabellings of the PAR families of batch `07`. -/
def CoveredPar07 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR028 ∨ F = permFam σ F_PAR029 ∨ F = permFam σ F_PAR030 ∨ F = permFam σ F_PAR031

theorem keevashPaddedSpec_of_coveredPar07 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar07 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR028
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR029
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR030
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR031

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

