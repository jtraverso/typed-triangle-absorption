theorem keevashPaddedSpec_PAR056 : PaddedInputs.KeevashPaddedSpec F_PAR056 :=
  keevashPaddedSpec_of_certs₈ F_PAR056 familyFacts_PAR056 universalCert_PAR056
    PaddedComponents.completeInverseCert₈_F_PAR056

