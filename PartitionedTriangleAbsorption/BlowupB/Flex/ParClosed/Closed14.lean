/-- The relabellings of the PAR families of batch `14`. -/
def CoveredPar14 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR056 ∨ F = permFam σ F_PAR057 ∨ F = permFam σ F_PAR058 ∨ F = permFam σ F_PAR059

theorem keevashPaddedSpec_of_coveredPar14 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar14 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR056
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR057
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR058
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR059

