module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv32
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv32` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR128 : FamilyFacts F_PAR128 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR128 : PaddedInputs.KeevashPaddedSpec F_PAR128 :=
  keevashPaddedSpec_of_certs₈ F_PAR128 familyFacts_PAR128 universalCert_PAR128
    PaddedComponents.completeInverseCert₈_F_PAR128

theorem familyFacts_PAR129 : FamilyFacts F_PAR129 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR129 : PaddedInputs.KeevashPaddedSpec F_PAR129 :=
  keevashPaddedSpec_of_certs₈ F_PAR129 familyFacts_PAR129 universalCert_PAR129
    PaddedComponents.completeInverseCert₈_F_PAR129

theorem familyFacts_PAR130 : FamilyFacts F_PAR130 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR130 : PaddedInputs.KeevashPaddedSpec F_PAR130 :=
  keevashPaddedSpec_of_certs₈ F_PAR130 familyFacts_PAR130 universalCert_PAR130
    PaddedComponents.completeInverseCert₈_F_PAR130

theorem familyFacts_PAR131 : FamilyFacts F_PAR131 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR131 : PaddedInputs.KeevashPaddedSpec F_PAR131 :=
  keevashPaddedSpec_of_certs₈ F_PAR131 familyFacts_PAR131 universalCert_PAR131
    PaddedComponents.completeInverseCert₈_F_PAR131

/-- The relabellings of the PAR families of batch `32`. -/
def CoveredPar32 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR128 ∨ F = permFam σ F_PAR129 ∨ F = permFam σ F_PAR130 ∨ F = permFam σ F_PAR131

theorem keevashPaddedSpec_of_coveredPar32 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar32 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR128
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR129
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR130
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR131

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

#print axioms PartitionedTriangleAbsorption.BlowupB.Flex.Par.keevashPaddedSpec_of_coveredPar32
