module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv49
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv49` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR196 : FamilyFacts F_PAR196 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR196 : PaddedInputs.KeevashPaddedSpec F_PAR196 :=
  keevashPaddedSpec_of_certs₈ F_PAR196 familyFacts_PAR196 universalCert_PAR196
    PaddedComponents.completeInverseCert₈_F_PAR196

theorem familyFacts_PAR197 : FamilyFacts F_PAR197 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR197 : PaddedInputs.KeevashPaddedSpec F_PAR197 :=
  keevashPaddedSpec_of_certs₈ F_PAR197 familyFacts_PAR197 universalCert_PAR197
    PaddedComponents.completeInverseCert₈_F_PAR197

theorem familyFacts_PAR198 : FamilyFacts F_PAR198 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR198 : PaddedInputs.KeevashPaddedSpec F_PAR198 :=
  keevashPaddedSpec_of_certs₈ F_PAR198 familyFacts_PAR198 universalCert_PAR198
    PaddedComponents.completeInverseCert₈_F_PAR198

theorem familyFacts_PAR199 : FamilyFacts F_PAR199 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR199 : PaddedInputs.KeevashPaddedSpec F_PAR199 :=
  keevashPaddedSpec_of_certs₈ F_PAR199 familyFacts_PAR199 universalCert_PAR199
    PaddedComponents.completeInverseCert₈_F_PAR199

/-- The relabellings of the PAR families of batch `49`. -/
def CoveredPar49 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR196 ∨ F = permFam σ F_PAR197 ∨ F = permFam σ F_PAR198 ∨ F = permFam σ F_PAR199

theorem keevashPaddedSpec_of_coveredPar49 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar49 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR196
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR197
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR198
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR199

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

