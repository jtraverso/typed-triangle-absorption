module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv65
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv65` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR512 : FamilyFacts F_PAR512 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR512 : PaddedInputs.KeevashPaddedSpec F_PAR512 :=
  keevashPaddedSpec_of_certs₈ F_PAR512 familyFacts_PAR512 universalCert_PAR512
    PaddedComponents.completeInverseCert₈_F_PAR512

theorem familyFacts_PAR513 : FamilyFacts F_PAR513 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR513 : PaddedInputs.KeevashPaddedSpec F_PAR513 :=
  keevashPaddedSpec_of_certs₈ F_PAR513 familyFacts_PAR513 universalCert_PAR513
    PaddedComponents.completeInverseCert₈_F_PAR513

theorem familyFacts_PAR514 : FamilyFacts F_PAR514 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR514 : PaddedInputs.KeevashPaddedSpec F_PAR514 :=
  keevashPaddedSpec_of_certs₈ F_PAR514 familyFacts_PAR514 universalCert_PAR514
    PaddedComponents.completeInverseCert₈_F_PAR514

theorem familyFacts_PAR515 : FamilyFacts F_PAR515 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR515 : PaddedInputs.KeevashPaddedSpec F_PAR515 :=
  keevashPaddedSpec_of_certs₈ F_PAR515 familyFacts_PAR515 universalCert_PAR515
    PaddedComponents.completeInverseCert₈_F_PAR515

/-- The relabellings of the PAR families of batch `65`. -/
def CoveredPar65 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR512 ∨ F = permFam σ F_PAR513 ∨ F = permFam σ F_PAR514 ∨ F = permFam σ F_PAR515

theorem keevashPaddedSpec_of_coveredPar65 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar65 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR512
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR513
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR514
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR515

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

