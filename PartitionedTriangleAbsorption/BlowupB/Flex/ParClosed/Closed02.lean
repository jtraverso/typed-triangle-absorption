/-! # `KeevashPaddedSpec` for the PAR families of `Inv02` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR008 : FamilyFacts F_PAR008 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR008 : PaddedInputs.KeevashPaddedSpec F_PAR008 :=
  keevashPaddedSpec_of_certs₈ F_PAR008 familyFacts_PAR008 universalCert_PAR008
    PaddedComponents.completeInverseCert₈_F_PAR008

theorem familyFacts_PAR009 : FamilyFacts F_PAR009 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR009 : PaddedInputs.KeevashPaddedSpec F_PAR009 :=
  keevashPaddedSpec_of_certs₈ F_PAR009 familyFacts_PAR009 universalCert_PAR009
    PaddedComponents.completeInverseCert₈_F_PAR009

theorem familyFacts_PAR010 : FamilyFacts F_PAR010 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR010 : PaddedInputs.KeevashPaddedSpec F_PAR010 :=
  keevashPaddedSpec_of_certs₈ F_PAR010 familyFacts_PAR010 universalCert_PAR010
    PaddedComponents.completeInverseCert₈_F_PAR010

theorem familyFacts_PAR011 : FamilyFacts F_PAR011 :=
