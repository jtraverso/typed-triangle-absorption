/-- The relabellings of the PAR families of batch `02`. -/
def CoveredPar02 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR008 ∨ F = permFam σ F_PAR009 ∨ F = permFam σ F_PAR010 ∨ F = permFam σ F_PAR011

theorem keevashPaddedSpec_of_coveredPar02 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar02 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR008
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR009
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR010
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR011

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

