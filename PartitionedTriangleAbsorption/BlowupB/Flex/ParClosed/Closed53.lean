module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv53
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv53` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR212 : FamilyFacts F_PAR212 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR212 : PaddedInputs.KeevashPaddedSpec F_PAR212 :=
  keevashPaddedSpec_of_certs₈ F_PAR212 familyFacts_PAR212 universalCert_PAR212
    PaddedComponents.completeInverseCert₈_F_PAR212

theorem familyFacts_PAR213 : FamilyFacts F_PAR213 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR213 : PaddedInputs.KeevashPaddedSpec F_PAR213 :=
  keevashPaddedSpec_of_certs₈ F_PAR213 familyFacts_PAR213 universalCert_PAR213
    PaddedComponents.completeInverseCert₈_F_PAR213

theorem familyFacts_PAR214 : FamilyFacts F_PAR214 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR214 : PaddedInputs.KeevashPaddedSpec F_PAR214 :=
  keevashPaddedSpec_of_certs₈ F_PAR214 familyFacts_PAR214 universalCert_PAR214
    PaddedComponents.completeInverseCert₈_F_PAR214

theorem familyFacts_PAR215 : FamilyFacts F_PAR215 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR215 : PaddedInputs.KeevashPaddedSpec F_PAR215 :=
  keevashPaddedSpec_of_certs₈ F_PAR215 familyFacts_PAR215 universalCert_PAR215
    PaddedComponents.completeInverseCert₈_F_PAR215

/-- The relabellings of the PAR families of batch `53`. -/
def CoveredPar53 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR212 ∨ F = permFam σ F_PAR213 ∨ F = permFam σ F_PAR214 ∨ F = permFam σ F_PAR215

theorem keevashPaddedSpec_of_coveredPar53 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar53 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR212
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR213
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR214
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR215

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

