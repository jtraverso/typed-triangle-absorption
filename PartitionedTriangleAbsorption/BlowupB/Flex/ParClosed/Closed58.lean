/-! # `KeevashPaddedSpec` for the PAR families of `Inv58` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR232 : FamilyFacts F_PAR232 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR232 : PaddedInputs.KeevashPaddedSpec F_PAR232 :=
  keevashPaddedSpec_of_certs₈ F_PAR232 familyFacts_PAR232 universalCert_PAR232
    PaddedComponents.completeInverseCert₈_F_PAR232

theorem familyFacts_PAR233 : FamilyFacts F_PAR233 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR233 : PaddedInputs.KeevashPaddedSpec F_PAR233 :=
  keevashPaddedSpec_of_certs₈ F_PAR233 familyFacts_PAR233 universalCert_PAR233
