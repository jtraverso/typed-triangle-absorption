/-- The relabellings of the PAR families of batch `58`. -/
def CoveredPar58 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR232 ∨ F = permFam σ F_PAR233 ∨ F = permFam σ F_PAR234 ∨ F = permFam σ F_PAR235

theorem keevashPaddedSpec_of_coveredPar58 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar58 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR232
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR233
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR234
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR235

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

