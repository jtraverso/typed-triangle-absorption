    PaddedComponents.completeInverseCert₈_F_PAR071

/-- The relabellings of the PAR families of batch `17`. -/
def CoveredPar17 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR068 ∨ F = permFam σ F_PAR069 ∨ F = permFam σ F_PAR070 ∨ F = permFam σ F_PAR071

theorem keevashPaddedSpec_of_coveredPar17 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar17 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR068
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR069
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR070
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR071

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

