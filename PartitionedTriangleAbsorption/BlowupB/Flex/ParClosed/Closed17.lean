@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv17` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR068 : FamilyFacts F_PAR068 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR068 : PaddedInputs.KeevashPaddedSpec F_PAR068 :=
  keevashPaddedSpec_of_certs₈ F_PAR068 familyFacts_PAR068 universalCert_PAR068
    PaddedComponents.completeInverseCert₈_F_PAR068

theorem familyFacts_PAR069 : FamilyFacts F_PAR069 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR069 : PaddedInputs.KeevashPaddedSpec F_PAR069 :=
  keevashPaddedSpec_of_certs₈ F_PAR069 familyFacts_PAR069 universalCert_PAR069
    PaddedComponents.completeInverseCert₈_F_PAR069

theorem familyFacts_PAR070 : FamilyFacts F_PAR070 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR070 : PaddedInputs.KeevashPaddedSpec F_PAR070 :=
  keevashPaddedSpec_of_certs₈ F_PAR070 familyFacts_PAR070 universalCert_PAR070
    PaddedComponents.completeInverseCert₈_F_PAR070

theorem familyFacts_PAR071 : FamilyFacts F_PAR071 :=
