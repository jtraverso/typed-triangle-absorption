/-! # `KeevashPaddedSpec` for the PAR families of `Inv27` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR108 : FamilyFacts F_PAR108 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR108 : PaddedInputs.KeevashPaddedSpec F_PAR108 :=
  keevashPaddedSpec_of_certs₈ F_PAR108 familyFacts_PAR108 universalCert_PAR108
    PaddedComponents.completeInverseCert₈_F_PAR108

theorem familyFacts_PAR109 : FamilyFacts F_PAR109 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR109 : PaddedInputs.KeevashPaddedSpec F_PAR109 :=
  keevashPaddedSpec_of_certs₈ F_PAR109 familyFacts_PAR109 universalCert_PAR109
    PaddedComponents.completeInverseCert₈_F_PAR109

theorem familyFacts_PAR110 : FamilyFacts F_PAR110 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR110 : PaddedInputs.KeevashPaddedSpec F_PAR110 :=
  keevashPaddedSpec_of_certs₈ F_PAR110 familyFacts_PAR110 universalCert_PAR110
