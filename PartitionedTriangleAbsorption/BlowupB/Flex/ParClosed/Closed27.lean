/-- The relabellings of the PAR families of batch `27`. -/
def CoveredPar27 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR108 ∨ F = permFam σ F_PAR109 ∨ F = permFam σ F_PAR110 ∨ F = permFam σ F_PAR111

theorem keevashPaddedSpec_of_coveredPar27 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar27 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR108
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR109
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR110
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR111

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

