module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv48
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv48` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR192 : FamilyFacts F_PAR192 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR192 : PaddedInputs.KeevashPaddedSpec F_PAR192 :=
  keevashPaddedSpec_of_certs₈ F_PAR192 familyFacts_PAR192 universalCert_PAR192
    PaddedComponents.completeInverseCert₈_F_PAR192

theorem familyFacts_PAR193 : FamilyFacts F_PAR193 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR193 : PaddedInputs.KeevashPaddedSpec F_PAR193 :=
  keevashPaddedSpec_of_certs₈ F_PAR193 familyFacts_PAR193 universalCert_PAR193
    PaddedComponents.completeInverseCert₈_F_PAR193

theorem familyFacts_PAR194 : FamilyFacts F_PAR194 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR194 : PaddedInputs.KeevashPaddedSpec F_PAR194 :=
  keevashPaddedSpec_of_certs₈ F_PAR194 familyFacts_PAR194 universalCert_PAR194
    PaddedComponents.completeInverseCert₈_F_PAR194

theorem familyFacts_PAR195 : FamilyFacts F_PAR195 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR195 : PaddedInputs.KeevashPaddedSpec F_PAR195 :=
  keevashPaddedSpec_of_certs₈ F_PAR195 familyFacts_PAR195 universalCert_PAR195
    PaddedComponents.completeInverseCert₈_F_PAR195

/-- The relabellings of the PAR families of batch `48`. -/
def CoveredPar48 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR192 ∨ F = permFam σ F_PAR193 ∨ F = permFam σ F_PAR194 ∨ F = permFam σ F_PAR195

theorem keevashPaddedSpec_of_coveredPar48 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar48 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR192
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR193
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR194
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR195

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

