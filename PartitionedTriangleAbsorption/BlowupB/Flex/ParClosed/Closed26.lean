module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv26
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv26` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR104 : FamilyFacts F_PAR104 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR104 : PaddedInputs.KeevashPaddedSpec F_PAR104 :=
  keevashPaddedSpec_of_certs₈ F_PAR104 familyFacts_PAR104 universalCert_PAR104
    PaddedComponents.completeInverseCert₈_F_PAR104

theorem familyFacts_PAR105 : FamilyFacts F_PAR105 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR105 : PaddedInputs.KeevashPaddedSpec F_PAR105 :=
  keevashPaddedSpec_of_certs₈ F_PAR105 familyFacts_PAR105 universalCert_PAR105
    PaddedComponents.completeInverseCert₈_F_PAR105

theorem familyFacts_PAR106 : FamilyFacts F_PAR106 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR106 : PaddedInputs.KeevashPaddedSpec F_PAR106 :=
  keevashPaddedSpec_of_certs₈ F_PAR106 familyFacts_PAR106 universalCert_PAR106
    PaddedComponents.completeInverseCert₈_F_PAR106

theorem familyFacts_PAR107 : FamilyFacts F_PAR107 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR107 : PaddedInputs.KeevashPaddedSpec F_PAR107 :=
  keevashPaddedSpec_of_certs₈ F_PAR107 familyFacts_PAR107 universalCert_PAR107
    PaddedComponents.completeInverseCert₈_F_PAR107

/-- The relabellings of the PAR families of batch `26`. -/
def CoveredPar26 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR104 ∨ F = permFam σ F_PAR105 ∨ F = permFam σ F_PAR106 ∨ F = permFam σ F_PAR107

theorem keevashPaddedSpec_of_coveredPar26 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar26 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR104
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR105
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR106
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR107

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

