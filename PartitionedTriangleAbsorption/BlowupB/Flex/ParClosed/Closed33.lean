/-- The relabellings of the PAR families of batch `33`. -/
def CoveredPar33 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR132 ∨ F = permFam σ F_PAR133 ∨ F = permFam σ F_PAR134 ∨ F = permFam σ F_PAR135

theorem keevashPaddedSpec_of_coveredPar33 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar33 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR132
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR133
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR134
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR135

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

