/-! # `KeevashPaddedSpec` for the PAR families of `Inv33` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR132 : FamilyFacts F_PAR132 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR132 : PaddedInputs.KeevashPaddedSpec F_PAR132 :=
  keevashPaddedSpec_of_certs₈ F_PAR132 familyFacts_PAR132 universalCert_PAR132
    PaddedComponents.completeInverseCert₈_F_PAR132

theorem familyFacts_PAR133 : FamilyFacts F_PAR133 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR133 : PaddedInputs.KeevashPaddedSpec F_PAR133 :=
  keevashPaddedSpec_of_certs₈ F_PAR133 familyFacts_PAR133 universalCert_PAR133
    PaddedComponents.completeInverseCert₈_F_PAR133

theorem familyFacts_PAR134 : FamilyFacts F_PAR134 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR134 : PaddedInputs.KeevashPaddedSpec F_PAR134 :=
  keevashPaddedSpec_of_certs₈ F_PAR134 familyFacts_PAR134 universalCert_PAR134
