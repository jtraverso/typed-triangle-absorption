/-- The relabellings of the PAR families of batch `06`. -/
def CoveredPar06 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR024 ∨ F = permFam σ F_PAR025 ∨ F = permFam σ F_PAR026 ∨ F = permFam σ F_PAR027

theorem keevashPaddedSpec_of_coveredPar06 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar06 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR024
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR025
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR026
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR027

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

