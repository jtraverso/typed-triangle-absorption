/-! # `KeevashPaddedSpec` for the PAR families of `Inv06` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR024 : FamilyFacts F_PAR024 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR024 : PaddedInputs.KeevashPaddedSpec F_PAR024 :=
  keevashPaddedSpec_of_certs₈ F_PAR024 familyFacts_PAR024 universalCert_PAR024
    PaddedComponents.completeInverseCert₈_F_PAR024

theorem familyFacts_PAR025 : FamilyFacts F_PAR025 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR025 : PaddedInputs.KeevashPaddedSpec F_PAR025 :=
  keevashPaddedSpec_of_certs₈ F_PAR025 familyFacts_PAR025 universalCert_PAR025
    PaddedComponents.completeInverseCert₈_F_PAR025

theorem familyFacts_PAR026 : FamilyFacts F_PAR026 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR026 : PaddedInputs.KeevashPaddedSpec F_PAR026 :=
  keevashPaddedSpec_of_certs₈ F_PAR026 familyFacts_PAR026 universalCert_PAR026
