module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv68
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv68` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR524 : FamilyFacts F_PAR524 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR524 : PaddedInputs.KeevashPaddedSpec F_PAR524 :=
  keevashPaddedSpec_of_certs₈ F_PAR524 familyFacts_PAR524 universalCert_PAR524
    PaddedComponents.completeInverseCert₈_F_PAR524

/-- The relabellings of the PAR families of batch `68`. -/
def CoveredPar68 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR524

theorem keevashPaddedSpec_of_coveredPar68 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar68 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR524

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

#print axioms PartitionedTriangleAbsorption.BlowupB.Flex.Par.keevashPaddedSpec_of_coveredPar68
