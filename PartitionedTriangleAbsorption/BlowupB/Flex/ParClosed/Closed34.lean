/-- The relabellings of the PAR families of batch `34`. -/
def CoveredPar34 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR136 ∨ F = permFam σ F_PAR137 ∨ F = permFam σ F_PAR138 ∨ F = permFam σ F_PAR139

theorem keevashPaddedSpec_of_coveredPar34 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar34 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR136
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR137
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR138
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR139

