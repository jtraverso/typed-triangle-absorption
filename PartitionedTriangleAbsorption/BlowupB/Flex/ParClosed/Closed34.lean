theorem familyFacts_PAR136 : FamilyFacts F_PAR136 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR136 : PaddedInputs.KeevashPaddedSpec F_PAR136 :=
  keevashPaddedSpec_of_certs₈ F_PAR136 familyFacts_PAR136 universalCert_PAR136
    PaddedComponents.completeInverseCert₈_F_PAR136

