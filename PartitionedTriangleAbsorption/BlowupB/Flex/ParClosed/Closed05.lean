module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv05
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv05` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR020 : FamilyFacts F_PAR020 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR020 : PaddedInputs.KeevashPaddedSpec F_PAR020 :=
  keevashPaddedSpec_of_certs₈ F_PAR020 familyFacts_PAR020 universalCert_PAR020
    PaddedComponents.completeInverseCert₈_F_PAR020

theorem familyFacts_PAR021 : FamilyFacts F_PAR021 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR021 : PaddedInputs.KeevashPaddedSpec F_PAR021 :=
  keevashPaddedSpec_of_certs₈ F_PAR021 familyFacts_PAR021 universalCert_PAR021
    PaddedComponents.completeInverseCert₈_F_PAR021

theorem familyFacts_PAR022 : FamilyFacts F_PAR022 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR022 : PaddedInputs.KeevashPaddedSpec F_PAR022 :=
  keevashPaddedSpec_of_certs₈ F_PAR022 familyFacts_PAR022 universalCert_PAR022
    PaddedComponents.completeInverseCert₈_F_PAR022

theorem familyFacts_PAR023 : FamilyFacts F_PAR023 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR023 : PaddedInputs.KeevashPaddedSpec F_PAR023 :=
  keevashPaddedSpec_of_certs₈ F_PAR023 familyFacts_PAR023 universalCert_PAR023
    PaddedComponents.completeInverseCert₈_F_PAR023

/-- The relabellings of the PAR families of batch `05`. -/
def CoveredPar05 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR020 ∨ F = permFam σ F_PAR021 ∨ F = permFam σ F_PAR022 ∨ F = permFam σ F_PAR023

theorem keevashPaddedSpec_of_coveredPar05 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar05 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR020
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR021
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR022
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR023

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

