/-- The relabellings of the PAR families of batch `22`. -/
def CoveredPar22 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR088 ∨ F = permFam σ F_PAR089 ∨ F = permFam σ F_PAR090 ∨ F = permFam σ F_PAR091

theorem keevashPaddedSpec_of_coveredPar22 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar22 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR088
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR089
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR090
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR091

