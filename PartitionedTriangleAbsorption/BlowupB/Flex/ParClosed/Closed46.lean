/-! # `KeevashPaddedSpec` for the PAR families of `Inv46` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR184 : FamilyFacts F_PAR184 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR184 : PaddedInputs.KeevashPaddedSpec F_PAR184 :=
  keevashPaddedSpec_of_certs₈ F_PAR184 familyFacts_PAR184 universalCert_PAR184
    PaddedComponents.completeInverseCert₈_F_PAR184

theorem familyFacts_PAR185 : FamilyFacts F_PAR185 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR185 : PaddedInputs.KeevashPaddedSpec F_PAR185 :=
  keevashPaddedSpec_of_certs₈ F_PAR185 familyFacts_PAR185 universalCert_PAR185
    PaddedComponents.completeInverseCert₈_F_PAR185

theorem familyFacts_PAR186 : FamilyFacts F_PAR186 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR186 : PaddedInputs.KeevashPaddedSpec F_PAR186 :=
  keevashPaddedSpec_of_certs₈ F_PAR186 familyFacts_PAR186 universalCert_PAR186
