/-- The relabellings of the PAR families of batch `46`. -/
def CoveredPar46 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR184 ∨ F = permFam σ F_PAR185 ∨ F = permFam σ F_PAR186 ∨ F = permFam σ F_PAR187

theorem keevashPaddedSpec_of_coveredPar46 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar46 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR184
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR185
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR186
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR187

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

