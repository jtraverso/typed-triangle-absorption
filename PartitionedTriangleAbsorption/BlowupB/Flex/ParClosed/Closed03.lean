module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv03
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv03` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR012 : FamilyFacts F_PAR012 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR012 : PaddedInputs.KeevashPaddedSpec F_PAR012 :=
  keevashPaddedSpec_of_certs₈ F_PAR012 familyFacts_PAR012 universalCert_PAR012
    PaddedComponents.completeInverseCert₈_F_PAR012

theorem familyFacts_PAR013 : FamilyFacts F_PAR013 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR013 : PaddedInputs.KeevashPaddedSpec F_PAR013 :=
  keevashPaddedSpec_of_certs₈ F_PAR013 familyFacts_PAR013 universalCert_PAR013
    PaddedComponents.completeInverseCert₈_F_PAR013

theorem familyFacts_PAR014 : FamilyFacts F_PAR014 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR014 : PaddedInputs.KeevashPaddedSpec F_PAR014 :=
  keevashPaddedSpec_of_certs₈ F_PAR014 familyFacts_PAR014 universalCert_PAR014
    PaddedComponents.completeInverseCert₈_F_PAR014

theorem familyFacts_PAR015 : FamilyFacts F_PAR015 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR015 : PaddedInputs.KeevashPaddedSpec F_PAR015 :=
  keevashPaddedSpec_of_certs₈ F_PAR015 familyFacts_PAR015 universalCert_PAR015
    PaddedComponents.completeInverseCert₈_F_PAR015

/-- The relabellings of the PAR families of batch `03`. -/
def CoveredPar03 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR012 ∨ F = permFam σ F_PAR013 ∨ F = permFam σ F_PAR014 ∨ F = permFam σ F_PAR015

theorem keevashPaddedSpec_of_coveredPar03 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar03 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR012
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR013
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR014
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR015

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

