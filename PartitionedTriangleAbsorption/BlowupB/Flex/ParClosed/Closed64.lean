module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv64
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv64` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR508 : FamilyFacts F_PAR508 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR508 : PaddedInputs.KeevashPaddedSpec F_PAR508 :=
  keevashPaddedSpec_of_certs₈ F_PAR508 familyFacts_PAR508 universalCert_PAR508
    PaddedComponents.completeInverseCert₈_F_PAR508

theorem familyFacts_PAR509 : FamilyFacts F_PAR509 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR509 : PaddedInputs.KeevashPaddedSpec F_PAR509 :=
  keevashPaddedSpec_of_certs₈ F_PAR509 familyFacts_PAR509 universalCert_PAR509
    PaddedComponents.completeInverseCert₈_F_PAR509

theorem familyFacts_PAR510 : FamilyFacts F_PAR510 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR510 : PaddedInputs.KeevashPaddedSpec F_PAR510 :=
  keevashPaddedSpec_of_certs₈ F_PAR510 familyFacts_PAR510 universalCert_PAR510
    PaddedComponents.completeInverseCert₈_F_PAR510

theorem familyFacts_PAR511 : FamilyFacts F_PAR511 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR511 : PaddedInputs.KeevashPaddedSpec F_PAR511 :=
  keevashPaddedSpec_of_certs₈ F_PAR511 familyFacts_PAR511 universalCert_PAR511
    PaddedComponents.completeInverseCert₈_F_PAR511

/-- The relabellings of the PAR families of batch `64`. -/
def CoveredPar64 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR508 ∨ F = permFam σ F_PAR509 ∨ F = permFam σ F_PAR510 ∨ F = permFam σ F_PAR511

theorem keevashPaddedSpec_of_coveredPar64 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar64 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR508
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR509
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR510
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR511

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

