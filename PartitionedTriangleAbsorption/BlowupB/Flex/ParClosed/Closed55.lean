module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv55
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv55` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR220 : FamilyFacts F_PAR220 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR220 : PaddedInputs.KeevashPaddedSpec F_PAR220 :=
  keevashPaddedSpec_of_certs₈ F_PAR220 familyFacts_PAR220 universalCert_PAR220
    PaddedComponents.completeInverseCert₈_F_PAR220

theorem familyFacts_PAR221 : FamilyFacts F_PAR221 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR221 : PaddedInputs.KeevashPaddedSpec F_PAR221 :=
  keevashPaddedSpec_of_certs₈ F_PAR221 familyFacts_PAR221 universalCert_PAR221
    PaddedComponents.completeInverseCert₈_F_PAR221

theorem familyFacts_PAR222 : FamilyFacts F_PAR222 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR222 : PaddedInputs.KeevashPaddedSpec F_PAR222 :=
  keevashPaddedSpec_of_certs₈ F_PAR222 familyFacts_PAR222 universalCert_PAR222
    PaddedComponents.completeInverseCert₈_F_PAR222

theorem familyFacts_PAR223 : FamilyFacts F_PAR223 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR223 : PaddedInputs.KeevashPaddedSpec F_PAR223 :=
  keevashPaddedSpec_of_certs₈ F_PAR223 familyFacts_PAR223 universalCert_PAR223
    PaddedComponents.completeInverseCert₈_F_PAR223

/-- The relabellings of the PAR families of batch `55`. -/
def CoveredPar55 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR220 ∨ F = permFam σ F_PAR221 ∨ F = permFam σ F_PAR222 ∨ F = permFam σ F_PAR223

theorem keevashPaddedSpec_of_coveredPar55 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar55 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR220
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR221
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR222
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR223

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

