module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv54
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv54` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR216 : FamilyFacts F_PAR216 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR216 : PaddedInputs.KeevashPaddedSpec F_PAR216 :=
  keevashPaddedSpec_of_certs₈ F_PAR216 familyFacts_PAR216 universalCert_PAR216
    PaddedComponents.completeInverseCert₈_F_PAR216

theorem familyFacts_PAR217 : FamilyFacts F_PAR217 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR217 : PaddedInputs.KeevashPaddedSpec F_PAR217 :=
  keevashPaddedSpec_of_certs₈ F_PAR217 familyFacts_PAR217 universalCert_PAR217
    PaddedComponents.completeInverseCert₈_F_PAR217

theorem familyFacts_PAR218 : FamilyFacts F_PAR218 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR218 : PaddedInputs.KeevashPaddedSpec F_PAR218 :=
  keevashPaddedSpec_of_certs₈ F_PAR218 familyFacts_PAR218 universalCert_PAR218
    PaddedComponents.completeInverseCert₈_F_PAR218

theorem familyFacts_PAR219 : FamilyFacts F_PAR219 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR219 : PaddedInputs.KeevashPaddedSpec F_PAR219 :=
  keevashPaddedSpec_of_certs₈ F_PAR219 familyFacts_PAR219 universalCert_PAR219
    PaddedComponents.completeInverseCert₈_F_PAR219

/-- The relabellings of the PAR families of batch `54`. -/
def CoveredPar54 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR216 ∨ F = permFam σ F_PAR217 ∨ F = permFam σ F_PAR218 ∨ F = permFam σ F_PAR219

theorem keevashPaddedSpec_of_coveredPar54 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar54 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR216
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR217
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR218
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR219

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

