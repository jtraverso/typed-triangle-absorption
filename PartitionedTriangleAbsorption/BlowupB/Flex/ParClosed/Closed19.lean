theorem familyFacts_PAR076 : FamilyFacts F_PAR076 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR076 : PaddedInputs.KeevashPaddedSpec F_PAR076 :=
  keevashPaddedSpec_of_certs₈ F_PAR076 familyFacts_PAR076 universalCert_PAR076
    PaddedComponents.completeInverseCert₈_F_PAR076

theorem familyFacts_PAR077 : FamilyFacts F_PAR077 :=
