/-- The relabellings of the PAR families of batch `19`. -/
def CoveredPar19 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR076 ∨ F = permFam σ F_PAR077 ∨ F = permFam σ F_PAR078 ∨ F = permFam σ F_PAR079

theorem keevashPaddedSpec_of_coveredPar19 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar19 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR076
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR077
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR078
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR079

