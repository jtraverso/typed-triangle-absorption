module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv00
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv00` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR000 : FamilyFacts F_PAR000 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR000 : PaddedInputs.KeevashPaddedSpec F_PAR000 :=
  keevashPaddedSpec_of_certs₈ F_PAR000 familyFacts_PAR000 universalCert_PAR000
    PaddedComponents.completeInverseCert₈_F_PAR000

theorem familyFacts_PAR001 : FamilyFacts F_PAR001 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR001 : PaddedInputs.KeevashPaddedSpec F_PAR001 :=
  keevashPaddedSpec_of_certs₈ F_PAR001 familyFacts_PAR001 universalCert_PAR001
    PaddedComponents.completeInverseCert₈_F_PAR001

theorem familyFacts_PAR002 : FamilyFacts F_PAR002 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR002 : PaddedInputs.KeevashPaddedSpec F_PAR002 :=
  keevashPaddedSpec_of_certs₈ F_PAR002 familyFacts_PAR002 universalCert_PAR002
    PaddedComponents.completeInverseCert₈_F_PAR002

theorem familyFacts_PAR003 : FamilyFacts F_PAR003 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR003 : PaddedInputs.KeevashPaddedSpec F_PAR003 :=
  keevashPaddedSpec_of_certs₈ F_PAR003 familyFacts_PAR003 universalCert_PAR003
    PaddedComponents.completeInverseCert₈_F_PAR003

/-- The relabellings of the PAR families of batch `00`. -/
def CoveredPar00 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR000 ∨ F = permFam σ F_PAR001 ∨ F = permFam σ F_PAR002 ∨ F = permFam σ F_PAR003

theorem keevashPaddedSpec_of_coveredPar00 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar00 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR000
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR001
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR002
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR003

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

