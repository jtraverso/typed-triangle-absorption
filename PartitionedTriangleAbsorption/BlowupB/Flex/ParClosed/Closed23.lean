@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv23` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR092 : FamilyFacts F_PAR092 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR092 : PaddedInputs.KeevashPaddedSpec F_PAR092 :=
  keevashPaddedSpec_of_certs₈ F_PAR092 familyFacts_PAR092 universalCert_PAR092
    PaddedComponents.completeInverseCert₈_F_PAR092

theorem familyFacts_PAR093 : FamilyFacts F_PAR093 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR093 : PaddedInputs.KeevashPaddedSpec F_PAR093 :=
  keevashPaddedSpec_of_certs₈ F_PAR093 familyFacts_PAR093 universalCert_PAR093
    PaddedComponents.completeInverseCert₈_F_PAR093

theorem familyFacts_PAR094 : FamilyFacts F_PAR094 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR094 : PaddedInputs.KeevashPaddedSpec F_PAR094 :=
  keevashPaddedSpec_of_certs₈ F_PAR094 familyFacts_PAR094 universalCert_PAR094
    PaddedComponents.completeInverseCert₈_F_PAR094

theorem familyFacts_PAR095 : FamilyFacts F_PAR095 :=
