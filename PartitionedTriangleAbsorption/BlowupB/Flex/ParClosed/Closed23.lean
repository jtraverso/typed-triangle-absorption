    PaddedComponents.completeInverseCert₈_F_PAR095

/-- The relabellings of the PAR families of batch `23`. -/
def CoveredPar23 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR092 ∨ F = permFam σ F_PAR093 ∨ F = permFam σ F_PAR094 ∨ F = permFam σ F_PAR095

theorem keevashPaddedSpec_of_coveredPar23 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar23 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR092
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR093
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR094
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR095

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

