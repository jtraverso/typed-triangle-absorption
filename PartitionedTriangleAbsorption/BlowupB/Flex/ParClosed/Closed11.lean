/-- The relabellings of the PAR families of batch `11`. -/
def CoveredPar11 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR044 ∨ F = permFam σ F_PAR045 ∨ F = permFam σ F_PAR046 ∨ F = permFam σ F_PAR047

theorem keevashPaddedSpec_of_coveredPar11 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar11 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR044
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR045
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR046
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR047

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

