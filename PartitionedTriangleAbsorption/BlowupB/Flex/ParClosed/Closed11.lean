module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv11
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv11` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR044 : FamilyFacts F_PAR044 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR044 : PaddedInputs.KeevashPaddedSpec F_PAR044 :=
  keevashPaddedSpec_of_certs₈ F_PAR044 familyFacts_PAR044 universalCert_PAR044
    PaddedComponents.completeInverseCert₈_F_PAR044

theorem familyFacts_PAR045 : FamilyFacts F_PAR045 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR045 : PaddedInputs.KeevashPaddedSpec F_PAR045 :=
  keevashPaddedSpec_of_certs₈ F_PAR045 familyFacts_PAR045 universalCert_PAR045
    PaddedComponents.completeInverseCert₈_F_PAR045

theorem familyFacts_PAR046 : FamilyFacts F_PAR046 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR046 : PaddedInputs.KeevashPaddedSpec F_PAR046 :=
  keevashPaddedSpec_of_certs₈ F_PAR046 familyFacts_PAR046 universalCert_PAR046
    PaddedComponents.completeInverseCert₈_F_PAR046

theorem familyFacts_PAR047 : FamilyFacts F_PAR047 :=
