module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv30
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv30` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR120 : FamilyFacts F_PAR120 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR120 : PaddedInputs.KeevashPaddedSpec F_PAR120 :=
  keevashPaddedSpec_of_certs₈ F_PAR120 familyFacts_PAR120 universalCert_PAR120
    PaddedComponents.completeInverseCert₈_F_PAR120

theorem familyFacts_PAR121 : FamilyFacts F_PAR121 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR121 : PaddedInputs.KeevashPaddedSpec F_PAR121 :=
  keevashPaddedSpec_of_certs₈ F_PAR121 familyFacts_PAR121 universalCert_PAR121
    PaddedComponents.completeInverseCert₈_F_PAR121

theorem familyFacts_PAR122 : FamilyFacts F_PAR122 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR122 : PaddedInputs.KeevashPaddedSpec F_PAR122 :=
  keevashPaddedSpec_of_certs₈ F_PAR122 familyFacts_PAR122 universalCert_PAR122
    PaddedComponents.completeInverseCert₈_F_PAR122

theorem familyFacts_PAR123 : FamilyFacts F_PAR123 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR123 : PaddedInputs.KeevashPaddedSpec F_PAR123 :=
  keevashPaddedSpec_of_certs₈ F_PAR123 familyFacts_PAR123 universalCert_PAR123
    PaddedComponents.completeInverseCert₈_F_PAR123

/-- The relabellings of the PAR families of batch `30`. -/
def CoveredPar30 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR120 ∨ F = permFam σ F_PAR121 ∨ F = permFam σ F_PAR122 ∨ F = permFam σ F_PAR123

theorem keevashPaddedSpec_of_coveredPar30 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar30 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR120
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR121
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR122
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR123

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

