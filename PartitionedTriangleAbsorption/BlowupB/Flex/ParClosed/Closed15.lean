module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv15
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv15` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR060 : FamilyFacts F_PAR060 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR060 : PaddedInputs.KeevashPaddedSpec F_PAR060 :=
  keevashPaddedSpec_of_certs₈ F_PAR060 familyFacts_PAR060 universalCert_PAR060
    PaddedComponents.completeInverseCert₈_F_PAR060

theorem familyFacts_PAR061 : FamilyFacts F_PAR061 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR061 : PaddedInputs.KeevashPaddedSpec F_PAR061 :=
  keevashPaddedSpec_of_certs₈ F_PAR061 familyFacts_PAR061 universalCert_PAR061
    PaddedComponents.completeInverseCert₈_F_PAR061

theorem familyFacts_PAR062 : FamilyFacts F_PAR062 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR062 : PaddedInputs.KeevashPaddedSpec F_PAR062 :=
  keevashPaddedSpec_of_certs₈ F_PAR062 familyFacts_PAR062 universalCert_PAR062
    PaddedComponents.completeInverseCert₈_F_PAR062

theorem familyFacts_PAR063 : FamilyFacts F_PAR063 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR063 : PaddedInputs.KeevashPaddedSpec F_PAR063 :=
  keevashPaddedSpec_of_certs₈ F_PAR063 familyFacts_PAR063 universalCert_PAR063
    PaddedComponents.completeInverseCert₈_F_PAR063

/-- The relabellings of the PAR families of batch `15`. -/
def CoveredPar15 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR060 ∨ F = permFam σ F_PAR061 ∨ F = permFam σ F_PAR062 ∨ F = permFam σ F_PAR063

theorem keevashPaddedSpec_of_coveredPar15 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar15 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR060
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR061
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR062
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR063

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

