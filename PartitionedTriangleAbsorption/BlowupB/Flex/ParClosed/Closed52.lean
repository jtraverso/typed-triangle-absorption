module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv52
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv52` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR208 : FamilyFacts F_PAR208 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR208 : PaddedInputs.KeevashPaddedSpec F_PAR208 :=
  keevashPaddedSpec_of_certs₈ F_PAR208 familyFacts_PAR208 universalCert_PAR208
    PaddedComponents.completeInverseCert₈_F_PAR208

theorem familyFacts_PAR209 : FamilyFacts F_PAR209 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR209 : PaddedInputs.KeevashPaddedSpec F_PAR209 :=
  keevashPaddedSpec_of_certs₈ F_PAR209 familyFacts_PAR209 universalCert_PAR209
    PaddedComponents.completeInverseCert₈_F_PAR209

theorem familyFacts_PAR210 : FamilyFacts F_PAR210 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR210 : PaddedInputs.KeevashPaddedSpec F_PAR210 :=
  keevashPaddedSpec_of_certs₈ F_PAR210 familyFacts_PAR210 universalCert_PAR210
    PaddedComponents.completeInverseCert₈_F_PAR210

theorem familyFacts_PAR211 : FamilyFacts F_PAR211 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR211 : PaddedInputs.KeevashPaddedSpec F_PAR211 :=
  keevashPaddedSpec_of_certs₈ F_PAR211 familyFacts_PAR211 universalCert_PAR211
    PaddedComponents.completeInverseCert₈_F_PAR211

/-- The relabellings of the PAR families of batch `52`. -/
def CoveredPar52 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR208 ∨ F = permFam σ F_PAR209 ∨ F = permFam σ F_PAR210 ∨ F = permFam σ F_PAR211

theorem keevashPaddedSpec_of_coveredPar52 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar52 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR208
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR209
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR210
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR211

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

