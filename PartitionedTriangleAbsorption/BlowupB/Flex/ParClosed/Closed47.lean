/-! # `KeevashPaddedSpec` for the PAR families of `Inv47` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR188 : FamilyFacts F_PAR188 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR188 : PaddedInputs.KeevashPaddedSpec F_PAR188 :=
  keevashPaddedSpec_of_certs₈ F_PAR188 familyFacts_PAR188 universalCert_PAR188
    PaddedComponents.completeInverseCert₈_F_PAR188

theorem familyFacts_PAR189 : FamilyFacts F_PAR189 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR189 : PaddedInputs.KeevashPaddedSpec F_PAR189 :=
  keevashPaddedSpec_of_certs₈ F_PAR189 familyFacts_PAR189 universalCert_PAR189
    PaddedComponents.completeInverseCert₈_F_PAR189

theorem familyFacts_PAR190 : FamilyFacts F_PAR190 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR190 : PaddedInputs.KeevashPaddedSpec F_PAR190 :=
  keevashPaddedSpec_of_certs₈ F_PAR190 familyFacts_PAR190 universalCert_PAR190
