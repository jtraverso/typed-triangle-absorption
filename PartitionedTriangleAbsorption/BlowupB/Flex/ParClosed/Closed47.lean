/-- The relabellings of the PAR families of batch `47`. -/
def CoveredPar47 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR188 ∨ F = permFam σ F_PAR189 ∨ F = permFam σ F_PAR190 ∨ F = permFam σ F_PAR191

theorem keevashPaddedSpec_of_coveredPar47 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar47 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR188
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR189
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR190
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR191

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

