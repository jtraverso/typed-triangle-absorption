/-- The relabellings of the PAR families of batch `04`. -/
def CoveredPar04 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR016 ∨ F = permFam σ F_PAR017 ∨ F = permFam σ F_PAR018 ∨ F = permFam σ F_PAR019

theorem keevashPaddedSpec_of_coveredPar04 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar04 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR016
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR017
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR018
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR019

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

