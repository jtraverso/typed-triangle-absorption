open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR016 : FamilyFacts F_PAR016 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR016 : PaddedInputs.KeevashPaddedSpec F_PAR016 :=
  keevashPaddedSpec_of_certs₈ F_PAR016 familyFacts_PAR016 universalCert_PAR016
    PaddedComponents.completeInverseCert₈_F_PAR016

theorem familyFacts_PAR017 : FamilyFacts F_PAR017 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR017 : PaddedInputs.KeevashPaddedSpec F_PAR017 :=
  keevashPaddedSpec_of_certs₈ F_PAR017 familyFacts_PAR017 universalCert_PAR017
