/-- The relabellings of the PAR families of batch `01`. -/
def CoveredPar01 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR004 ∨ F = permFam σ F_PAR005 ∨ F = permFam σ F_PAR006 ∨ F = permFam σ F_PAR007

theorem keevashPaddedSpec_of_coveredPar01 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar01 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR004
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR005
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR006
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR007

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

