/-! # `KeevashPaddedSpec` for the PAR families of `Inv01` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR004 : FamilyFacts F_PAR004 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR004 : PaddedInputs.KeevashPaddedSpec F_PAR004 :=
  keevashPaddedSpec_of_certs₈ F_PAR004 familyFacts_PAR004 universalCert_PAR004
    PaddedComponents.completeInverseCert₈_F_PAR004

theorem familyFacts_PAR005 : FamilyFacts F_PAR005 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR005 : PaddedInputs.KeevashPaddedSpec F_PAR005 :=
  keevashPaddedSpec_of_certs₈ F_PAR005 familyFacts_PAR005 universalCert_PAR005
