/-- The relabellings of the PAR families of batch `08`. -/
def CoveredPar08 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR032 ∨ F = permFam σ F_PAR033 ∨ F = permFam σ F_PAR034 ∨ F = permFam σ F_PAR035

theorem keevashPaddedSpec_of_coveredPar08 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar08 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR032
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR033
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR034
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR035

