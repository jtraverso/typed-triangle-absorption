theorem familyFacts_PAR032 : FamilyFacts F_PAR032 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR032 : PaddedInputs.KeevashPaddedSpec F_PAR032 :=
  keevashPaddedSpec_of_certs₈ F_PAR032 familyFacts_PAR032 universalCert_PAR032
    PaddedComponents.completeInverseCert₈_F_PAR032

