module

public import PartitionedTriangleAbsorption.BlowupB.Flex.ParInv.Inv10
public import PartitionedTriangleAbsorption.BlowupB.KeevashPerm

@[expose] public section

/-! # `KeevashPaddedSpec` for the PAR families of `Inv10` (generated by `gen_par_closed.py`) -/

namespace PartitionedTriangleAbsorption.BlowupB.Flex.Par

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.TypedTransformer PaddedGeneral

theorem familyFacts_PAR040 : FamilyFacts F_PAR040 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR040 : PaddedInputs.KeevashPaddedSpec F_PAR040 :=
  keevashPaddedSpec_of_certs₈ F_PAR040 familyFacts_PAR040 universalCert_PAR040
    PaddedComponents.completeInverseCert₈_F_PAR040

theorem familyFacts_PAR041 : FamilyFacts F_PAR041 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR041 : PaddedInputs.KeevashPaddedSpec F_PAR041 :=
  keevashPaddedSpec_of_certs₈ F_PAR041 familyFacts_PAR041 universalCert_PAR041
    PaddedComponents.completeInverseCert₈_F_PAR041

theorem familyFacts_PAR042 : FamilyFacts F_PAR042 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR042 : PaddedInputs.KeevashPaddedSpec F_PAR042 :=
  keevashPaddedSpec_of_certs₈ F_PAR042 familyFacts_PAR042 universalCert_PAR042
    PaddedComponents.completeInverseCert₈_F_PAR042

theorem familyFacts_PAR043 : FamilyFacts F_PAR043 :=
  ⟨by decide +kernel, by unfold Link; decide +kernel, by unfold Link; decide +kernel⟩

theorem keevashPaddedSpec_PAR043 : PaddedInputs.KeevashPaddedSpec F_PAR043 :=
  keevashPaddedSpec_of_certs₈ F_PAR043 familyFacts_PAR043 universalCert_PAR043
    PaddedComponents.completeInverseCert₈_F_PAR043

/-- The relabellings of the PAR families of batch `10`. -/
def CoveredPar10 (F : Finset (Multiset (Fin 4))) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), F = permFam σ F_PAR040 ∨ F = permFam σ F_PAR041 ∨ F = permFam σ F_PAR042 ∨ F = permFam σ F_PAR043

theorem keevashPaddedSpec_of_coveredPar10 (F : Finset (Multiset (Fin 4))) (hF : CoveredPar10 F) :
    PaddedInputs.KeevashPaddedSpec F := by
  obtain ⟨σ, rfl | rfl | rfl | rfl⟩ := hF
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR040
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR041
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR042
  · exact keevashPaddedSpec_perm σ keevashPaddedSpec_PAR043

end PartitionedTriangleAbsorption.BlowupB.Flex.Par

