theorem charge_scales_N_flex (ω n δ ρ lam Q lamT : ℝ) (h : Flex.FlexScales ω δ ρ n) (hlam : lam = ω * δ / 2 ^ 48)
    (hQ : Q = δ * n / 2 ^ 33) (hlamT : lamT = δ / 2 ^ 33) :
    0 < lam ∧ lam ≤ 1 / 64 ∧ 0 < ρ ∧ 2 ^ 24 * ρ ≤ lam ^ 2 ∧ 256 ≤ lam * n ∧ 0 < δ ∧ 0 < Q ∧
    0 < lamT ∧ 1024 * lamT ≤ ω ∧ (2 ^ 32 : ℝ) * ρ ≤ lamT ^ 2 ∧
    3 * (4100 * lam * n ^ 2) / Q + 3 +
      2 * (2 * ρ * n + 4 * lam * n + 2 * (Q + (4096 * lam * n + 1)) + 2) < ω * n ∧
    (2 ^ 21 : ℝ) + (2 ^ 21 : ℝ) * (2 * δ * n) < ω * n / 2 ∧
    (2 ^ 21 : ℝ) ≤ δ * n / 4 ∧
    2 * ρ * n + (4 * lam * n + 2 * (Q + (4096 * lam * n + 1))) ≤ 6 * lamT * n ∧
    2 * ρ * n + (4 * lam * n + 2 * (Q + (4096 * lam * n + 1))) + lamT * n ≤ δ * n ∧
    (2 ^ 21 : ℝ) * (4096 * lam * n + 2 * (Q + (4096 * lam * n + 1)) + 44 * (lamT * n)) ≤
      δ * n / 2 ∧
    4 * (2 * ρ + 16 * lam + 6 * 2 ^ 21 * ρ + 2 ^ 24 * ρ * 2 ^ 21) ≤ δ * ω := by
  obtain ⟨hω, hω1, hδ0, hδ1, hsq, hnn, hn⟩ := h
  have hA0 : 0 < ω ^ 12 := by positivity
  have hA1 : ω ^ 12 ≤ ω := pow_le_of_le_one hω.le hω1 (by norm_num)
  have hA2 : ω ^ 12 ≤ 1 := hA1.trans hω1
  have hδω : 2 ^ 63 * δ ≤ ω := hδ1
  have hlam0 : 0 < lam := by rw [hlam]; positivity
  have hlamT0 : 0 < lamT := by rw [hlamT]; positivity
  have hlamδ : 2 ^ 48 * lam ≤ δ := by rw [hlam]; nlinarith
  have hρ0 : 0 < ρ := by
    by_contra hc
    have : ρ ≤ 0 := le_of_not_gt hc
    nlinarith
  have hsq' : 2 ^ 24 * ρ ≤ lam ^ 2 := by rw [hlam]; exact hsq
  have hlamsq : 2 ^ 24 * ρ ≤ lam ^ 2 := hsq'
  have hlam_small : 2 ^ 111 * lam ≤ 1 := by nlinarith
  have hlam2 : lam ^ 2 * 2 ^ 111 ≤ lam := by
    have := mul_le_mul_of_nonneg_left hlam_small hlam0.le
    nlinarith
  have hρlam : 2 ^ 135 * ρ ≤ lam := by nlinarith
  have hlamT_lam : 2 ^ 15 * lam ≤ lamT := by rw [hlam, hlamT]; nlinarith
  have hsqT : (2 ^ 15 * lam) ^ 2 ≤ lamT ^ 2 := pow_le_pow_left₀ (by positivity) hlamT_lam 2
  have hTsq : (2 ^ 32 : ℝ) * ρ ≤ lamT ^ 2 := by nlinarith
  have hn0 : 0 < n := by
    by_contra h
    have h' : n ≤ 0 := le_of_not_gt h
    nlinarith
  have hρn : 2 ^ 135 ≤ lam * n := by nlinarith
  have hlamn : 2 ^ 48 * (lam * n) ≤ δ * n := by nlinarith
  have hδn : 2 ^ 63 * (δ * n) ≤ ω * n := by nlinarith
  have hρn' : 2 ^ 135 * (ρ * n) ≤ lam * n := by nlinarith
  have hQ0 : 0 < Q := by rw [hQ]; positivity
  have hTn : lamT * n = Q := by rw [hlamT, hQ]; ring
  have hdiv : 3 * (4100 * lam * n ^ 2) / Q = 12300 / 2 ^ 15 * ω * n := by
    rw [hQ, hlam]; field_simp; ring
  have hQd : Q = δ * n / 2 ^ 33 := hQ
  have hlamn1 : 2 ^ 135 ≤ lam * n := hρn
  refine ⟨hlam0, ?_, hρ0, hlamsq, by linarith, hδ0, hQ0, hlamT0, ?_, hTsq, ?_, ?_, ?_, ?_, ?_,
    ?_, ?_⟩
  · nlinarith
  · rw [hlamT]; linarith
  · rw [hdiv, hQd]; linarith
  · linarith
  · linarith
  · linarith
  · linarith
  · linarith
  · rw [hlam]
    have : 0 ≤ ω * δ := by positivity
    have h1 : ρ ≤ lam / 2 ^ 135 := by linarith
    rw [hlam] at h1
    linarith

