instance (C : Finset (Fin 20)) : Decidable (UsesAll C) := by
  unfold UsesAll
  infer_instance

inductive MaskTree where
  | empty
  | node (left : MaskTree) (key : ℕ) (right : MaskTree)

def MaskTree.contains : MaskTree → ℕ → Bool
  | .empty, _ => false
  | .node l k r, n => if n < k then l.contains n else if k < n then r.contains n else true

def MaskTree.entries : MaskTree → List ℕ
  | .empty => []
  | .node l k r => l.entries ++ k :: r.entries

theorem MaskTree.contains_sound (t : MaskTree) (n : ℕ) :
    t.contains n = true → n ∈ t.entries := by
  induction t with
  | empty => simp [contains]
  | node l k r hl hr =>
    simp only [contains]
    split_ifs with h₁ h₂
    · intro h
      exact List.mem_append_left _ (hl h)
    · intro h
      exact List.mem_append_right _ (List.mem_cons_of_mem k (hr h))
    · intro _
      have hn : n = k := by omega
      simp [entries,hn]

