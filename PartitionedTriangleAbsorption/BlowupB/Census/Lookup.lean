theorem repTree_entries : repTree.entries = representativeMasks := rfl

def repMem (n : ℕ) : Bool := repTree.contains n

theorem repMem_sound (n : ℕ) (h : repMem n = true) : n ∈ representativeMasks := by
  rw [← repTree_entries]
  exact MaskTree.contains_sound repTree n h

