namespace PartitionedTriangleAbsorption.TypedApplicationLinks



/-- The source definition of `F0`. -/
def F0 : Finset (Multiset (Fin 2)) := {{0, 0, 1}, {0, 1, 1}}

/-- The opposite label in a two-part partition. -/
def other0 : Fin 2 → Fin 2 := ![1, 0]

end PartitionedTriangleAbsorption.TypedApplicationLinks

namespace PartitionedTriangleAbsorption.CloneSupply

open Finset
variable {V : Type*} [Fintype V] [DecidableEq V]

/-- `V_i`: the vertices of part `i`. -/
def partSet (p : V → Fin 2) (i : Fin 2) : Finset V :=
  univ.filter fun v => p v = i

/-- `N_i(x)`: the neighbours of `x` lying in part `i`. -/
def partNbrs (p : V → Fin 2) (G : SimpleGraph V) [DecidableRel G.Adj] (i : Fin 2)
    (x : V) : Finset V :=
  univ.filter fun v => p v = i ∧ G.Adj x v

/-- `d_i(x) = |N_i(x)|`. -/
def partDeg (p : V → Fin 2) (G : SimpleGraph V) [DecidableRel G.Adj] (i : Fin 2)
    (x : V) : ℕ :=
  (partNbrs p G i x).card

end PartitionedTriangleAbsorption.CloneSupply

namespace PartitionedTriangleAbsorption.BlowupB.F0Direct

open Finset CloneSupply TypedApplicationLinks
variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The complete bipartite or two-clique adjacency pattern on the chosen side. -/
def orderedSideTarget (X : Finset V) (b : Bool) (x y : V) : Prop :=
  if b then (x ∈ X ↔ y ∉ X) else (x ∈ X ↔ y ∈ X)

open Classical in
/-- Number of ordered off-diagonal adjacency disagreements with that pattern. -/
noncomputable def orderedSideCost (G : SimpleGraph V) (D X : Finset V) (b : Bool) : ℕ :=
  ((D ×ˢ D).filter (fun q => q.1 ≠ q.2 ∧
    ¬ (G.Adj q.1 q.2 ↔ orderedSideTarget X b q.1 q.2))).card

/-- Paper II, Theorem C: mixed triangles in a semidense two-part host. -/

theorem theorem146_ordered :
    ∀ α : ℝ, 0 < α → ∃ ε : ℝ, 0 < ε ∧ ∃ N : ℕ,
      ∀ (V : Type) [Fintype V] [DecidableEq V], N ≤ Fintype.card V →
        ∀ (p : V → Fin 2) (G : SimpleGraph V) [DecidableRel G.Adj],
          (∀ i, (1 - ε) * Fintype.card V / 2 ≤ ((partSet p i).card : ℝ)) →
          (∀ v, (1 / 4 - ε) * Fintype.card V ≤ (partDeg p G (p v) v : ℝ)) →
          (∀ v, (partDeg p G (p v) v : ℝ) ≤ (1 / 4 + ε) * Fintype.card V) →
          (∀ v, (1 / 2 - ε) * Fintype.card V ≤ (partDeg p G (other0 (p v)) v : ℝ)) →
          (∃ i, ¬ ∃ X ⊆ partSet p i, X.card = (partSet p i).card / 2 ∧
            ∃ b : Bool, (orderedSideCost G (partSet p i) X b : ℝ) ≤
              2 * α * ((partSet p i).card : ℝ)^2) →
          IsIntDiv p F0 G.edgeFinset → HasDecomp p F0 G.edgeFinset := by
  sorry

end PartitionedTriangleAbsorption.BlowupB.F0Direct

namespace PartitionedTriangleAbsorption.SignedCertificate

open Finset
variable {V : Type*} [Fintype V] [DecidableEq V] {ι : Type*} [Fintype ι]

/-- Integer indicator of an edge set. -/
def ind (S : Finset (Sym2 V)) (e : Sym2 V) : ℤ := if e ∈ S then 1 else 0

/-- The size `∑ j |c j|` of a certificate. -/
def certWeight (c : ι → ℤ) : ℤ := ∑ j, |c j|

end PartitionedTriangleAbsorption.SignedCertificate

namespace PartitionedTriangleAbsorption.SignedHinge

open Finset
variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

open Classical in
/-- **Explicit physical hinge supply** (the extra hypothesis, counted over actual edge sets). -/
def HingeSupply (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    [DecidableRel G.Adj] (β : ℝ) (C0 : ℕ) : Prop :=
  ∀ S S' : Finset V, IsCopy p F G S → IsCopy p F G S' → (triEdges S ∩ triEdges S').card = 1 →
    ∃ i ∈ Icc 6 C0, β * (Fintype.card V : ℝ) ^ (i - 4) ≤
      ((G.edgeFinset.powerset.filter fun H => IsHinge p F S S' H ∧ (vertSet H).card = i).card :
        ℝ)

end PartitionedTriangleAbsorption.SignedHinge

namespace PartitionedTriangleAbsorption.BlowupB.LemmaSC

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.SignedHinge PartitionedTriangleAbsorption.SignedCertificate

/-- The single-part partition. -/
def onePart {V : Type*} : V → Fin 1 := fun _ => 0

/-- The family `{K₃} = {T₀₀₀}` for `t = 1`. -/
def K3fam : Finset (Multiset (Fin 1)) := {{0, 0, 0}}

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Paper II, Lemma SC: a bounded signed certificate yields a terminal absorber. -/

theorem absorber_onePart (α β : ℝ) (C0 K z : ℕ) (G : SimpleGraph V) [DecidableRel G.Adj]
    (hcand : ∀ u v w0 : V, u ≠ v → α * Fintype.card V ≤
      (univ.filter fun w => G.Adj u w ∧ G.Adj w v ∧ onePart w = onePart w0).card)
    (hsup : HingeSupply onePart K3fam G β C0) {ι : Type*} [Fintype ι] (P : Finset (Sym2 V))
    (t : ι → Finset V) (c : ι → ℤ) (hcopy : ∀ j, IsCopy onePart K3fam G (t j))
    (hid : ∀ e, ind P e = ∑ j, c j * ind (triEdges (t j)) e)
    (hK : certWeight c ≤ K) (Z : Finset V) (hPZ : ∀ e ∈ P, ∀ v ∈ e, v ∈ Z) (hZ : Z.card ≤ z)
    (hαM : ((z + 3 * K + 4 * K * C0 + 1 : ℕ) : ℝ) < α * Fintype.card V)
    (hβM : (2 ^ Nat.choose (C0 + 1) 2 : ℝ) * ((z + 3 * K + 4 * K * C0 + 1 : ℕ) : ℝ) <
      β * Fintype.card V) :
    ∃ A : Finset (Sym2 V), A ⊆ G.edgeFinset ∧ Disjoint A P ∧
      HasDecomp onePart K3fam A ∧ HasDecomp onePart K3fam (A ∪ P) ∧
      (∀ e ∈ A, ∃ v ∈ e, v ∉ Z) ∧ A.card ≤ 4 * K * (Nat.choose (C0 + 1) 2 + 2) := by
  sorry

end PartitionedTriangleAbsorption.BlowupB.LemmaSC
