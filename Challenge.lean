module

public import Mathlib

/-!
# Robust absorption for typed triangles — Paper II

The compared statements are Theorems A, B, C and D, the balanced consequence
of B, and terminal absorption Lemma SC. All definitions below are reproduced
from the frozen proof library with their original names and bodies.

The typical-host property includes positive regular triangle weights, common-
neighbour extension and both global and local integral divisibility. The
four-label theorem is not a theorem for arbitrary divisible hosts. The
semidense theorem uses ordered edit cost. Lemma SC explicitly assumes physical
hinge supply with exponent i - 4 after fixing four roots.

Only Mathlib is imported here. Solution imports the proofs, including the
finite census and conserved-family constructions; none is a hypothesis.
-/

@[expose] public section


namespace PartitionedTriangleAbsorption

open Finset
variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

/-- Contribution of a single edge to the (ordered) edge-count vector. -/
def pairVec (p : V → Fin t) (e : Sym2 V) : Fin t → Fin t → ℤ :=
  Sym2.lift ⟨fun u v i j => (if p u = i ∧ p v = j then 1 else 0) +
      (if p v = i ∧ p u = j then 1 else 0), by
    intro u v; funext i j; exact add_comm _ _⟩ e

/-- Contribution of a single edge to the degree vector of the vertex `v`. -/
def degContrib (p : V → Fin t) (v : V) (e : Sym2 V) : Fin t → ℤ :=
  Sym2.lift ⟨fun a b i => (if a = v ∧ p b = i then 1 else 0) +
      (if b = v ∧ p a = i then 1 else 0), by
    intro a b; funext i; exact add_comm _ _⟩ e

/-- The (ordered) edge-count vector of an edge set. -/
def edgeVec (p : V → Fin t) (E : Finset (Sym2 V)) : Fin t → Fin t → ℤ :=
  ∑ e ∈ E, pairVec p e

/-- The degree vector `d_E(v) = (|N_E(v) ∩ V_i| : i ∈ [t])`. -/
def degVec (p : V → Fin t) (E : Finset (Sym2 V)) (v : V) : Fin t → ℤ :=
  ∑ e ∈ E, degContrib p v e

/-- The (ordered) edge-count vector of the partitioned triangle `τ = T_{ijk}`. -/
def typeEdgeVec (τ : Multiset (Fin t)) : Fin t → Fin t → ℤ :=
  fun i j => (τ.count i : ℤ) * τ.count j - if i = j then (τ.count i : ℤ) else 0

/-- The degree vector of a vertex of part `a` inside the partitioned triangle `τ`. -/
def typeDegVec (τ : Multiset (Fin t)) (a : Fin t) : Fin t → ℤ :=
  fun i => (τ.count i : ℤ) - if i = a then 1 else 0

/-- **Integral `F`-divisibility** (Definition 13.5): the edge vector lies in the lattice
generated by the edge vectors of the types in `F`, and for every vertex `v` the degree vector
`d(v)` lies in the lattice generated by the degree vectors of the vertices of part `p v`
in the types of `F`. -/
def IsIntDiv (p : V → Fin t) (F : Finset (Multiset (Fin t))) (E : Finset (Sym2 V)) : Prop :=
  (∃ c : Multiset (Fin t) → ℤ, edgeVec p E = ∑ τ ∈ F, c τ • typeEdgeVec τ) ∧
    ∀ v : V, ∃ c : Multiset (Fin t) → ℤ,
      degVec p E v = ∑ τ ∈ F with p v ∈ τ, c τ • typeDegVec τ (p v)

/-- The edge set of the triangle with vertex set `s`. -/
def triEdges (s : Finset V) : Finset (Sym2 V) := s.sym2.filter (fun e => ¬ e.IsDiag)

/-- `s` is a triangle (3-vertex set) whose multiset of parts is a type of `F`. -/
def IsTypedTri (p : V → Fin t) (F : Finset (Multiset (Fin t))) (s : Finset V) : Prop :=
  s.card = 3 ∧ s.val.map p ∈ F

/-- `D` is an `F`-decomposition of the edge set `E`: a family of typed triangles whose edge
sets are pairwise disjoint and whose union is exactly `E`. -/
def IsDecomp (p : V → Fin t) (F : Finset (Multiset (Fin t))) (E : Finset (Sym2 V))
    (D : Finset (Finset V)) : Prop :=
  (∀ s ∈ D, IsTypedTri p F s) ∧ (D : Set (Finset V)).PairwiseDisjoint triEdges ∧
    D.biUnion triEdges = E

/-- The edge set `E` admits an `F`-decomposition. -/
def HasDecomp (p : V → Fin t) (F : Finset (Multiset (Fin t))) (E : Finset (Sym2 V)) : Prop :=
  ∃ D, IsDecomp p F E D

/-- An `F`-copy in the graph `G`: a triangle of `G` whose type belongs to `F`. -/
def IsCopy (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    (s : Finset V) : Prop :=
  G.IsNClique 3 s ∧ s.val.map p ∈ F

/-- The set of vertices covered by an edge set. -/
def vertSet (H : Finset (Sym2 V)) : Finset V := univ.filter (fun v => ∃ e ∈ H, v ∈ e)

/-- `H` is an **`F`-hinge** for the copies `S, S'` (sharing exactly one edge `e`)
(Definition 13.14): `H` is edge-disjoint from `S ∪ S'` and both `H ∪ (S - e)` and
`H ∪ (S' - e)` admit `F`-decompositions. -/
def IsHinge (p : V → Fin t) (F : Finset (Multiset (Fin t))) (S S' : Finset V)
    (H : Finset (Sym2 V)) : Prop :=
  Disjoint H (triEdges S ∪ triEdges S') ∧
    HasDecomp p F (H ∪ (triEdges S \ triEdges S')) ∧
    HasDecomp p F (H ∪ (triEdges S' \ triEdges S))

end PartitionedTriangleAbsorption

namespace PartitionedTriangleAbsorption.TypedTransformer

variable {t : ℕ}

/-- A link edge records an allowed triangle, retaining repeated parts. -/
def Link (F : Finset (Multiset (Fin t))) (r a b : Fin t) : Prop :=
  ({r, a, b} : Multiset (Fin t)) ∈ F

/-- The length-three walks required by the eleven-edge transformer. -/
def ThreeStepLinks (F : Finset (Multiset (Fin t))) : Prop :=
  ∀ r a b, (∃ c, Link F r a c) → (∃ c, Link F r b c) →
    ∃ v w, Link F r a v ∧ Link F r v w ∧ Link F r w b

end PartitionedTriangleAbsorption.TypedTransformer

namespace PaddedGeneral

open PartitionedTriangleAbsorption.TypedTransformer

/-- The finite facts about `F` used by the assembly. -/
structure FamilyFacts (F : Finset (Multiset (Fin 4))) : Prop where
  card_three : ∀ τ ∈ F, Multiset.card τ = 3
  allowed_of_triangle : ∀ i j k : Fin 4, ({i, j, k} : Multiset (Fin 4)) ∈ F →
    (∃ a, Link F i k a) ∧ (∃ a, Link F j k a)
  forbidden : ∀ i : Fin 4, ∃ j, ¬ ∃ k, Link F i j k

end PaddedGeneral

namespace PartitionedTriangleAbsorption.BlowupB

open Finset
variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

/-- The pair of classes `{i, j}` is contained in some (3-element) type of `F`. -/
def AllowedPair (F : Finset (Multiset (Fin t))) (i j : Fin t) : Prop :=
  ∃ τ ∈ F, Multiset.card τ = 3 ∧ ({i, j} : Multiset (Fin t)) ≤ τ

/-- Third vertices `w` closing a triangle `{u, v, w}` of type `τ` with `uw, vw ∈ G`. -/
def thirdsT {t : ℕ} {V : Type u_1} [Fintype V] [DecidableEq V] (p : V → Fin t) (G : Finset (Sym2 V)) (u v : V) (τ : Multiset (Fin t)) :
    Finset V :=
  univ.filter fun w => w ≠ u ∧ w ≠ v ∧ s(u, w) ∈ G ∧ s(v, w) ∈ G ∧
    ({p u, p v, p w} : Multiset (Fin t)) = τ

/-- Regularity with weights on typed triangles: every typed triangle of `G` has weight in
`[ω/n, 1/(ω n)]` and every edge of `G` has load `1 ± c`. -/
def TriRegular {t : ℕ} {V : Type u_1} [Fintype V] [DecidableEq V] (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : Finset (Sym2 V))
    (ω c : ℝ) : Prop :=
  ∃ y : Finset V → ℝ,
    (∀ s : Finset V, IsTypedTri p F s → triEdges s ⊆ G →
      ω / Fintype.card V ≤ y s ∧ y s ≤ 1 / (ω * Fintype.card V)) ∧
    ∀ u v, s(u, v) ∈ G → |(∑ τ ∈ F, ∑ w ∈ thirdsT p G u v τ, y {u, v, w}) - 1| ≤ c

/-- Extendability by common neighbourhoods: for every `S` with `|S| ≤ h`, every class `i` and
every `A ⊆ S` joined to `i` by allowed pairs, at least `ω n` vertices of class `i` outside `S`
are `G`-adjacent to all of `A`. -/
def CNExt {t : ℕ} {V : Type u_1} [Fintype V] [DecidableEq V] (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : Finset (Sym2 V)) (ω : ℝ)
    (h : ℕ) : Prop :=
  ∀ (S A : Finset V) (i : Fin t), S.card ≤ h → A ⊆ S → (∀ a ∈ A, AllowedPair F (p a) i) →
    ω * Fintype.card V ≤
      ((univ.filter fun v => p v = i ∧ v ∉ S ∧ ∀ a ∈ A, s(a, v) ∈ G).card : ℝ)

/-- **Typed Keevash interface** (specialisation of Keevash, Designs II, Theorem 3.1). -/
def KeevashTypedSpec (F : Finset (Multiset (Fin t))) : Prop :=
  ∀ γ : ℝ, 0 < γ →
  ∃ (h : ℕ) (ω₀ : ℝ), 0 < ω₀ ∧ ∀ ω : ℝ, 0 < ω → ω ≤ ω₀ → ∃ c : ℝ, 0 < c ∧ ∃ n₀ : ℕ,
    ∀ {V : Type} [Fintype V] [DecidableEq V] (p : V → Fin t) (G : Finset (Sym2 V)),
      n₀ ≤ Fintype.card V →
      (∀ i, γ * Fintype.card V ≤ ((univ.filter fun v => p v = i).card : ℝ)) →
      (∀ e ∈ G, ¬ e.IsDiag) →
      (∀ u v, s(u, v) ∈ G → AllowedPair F (p u) (p v)) →
      TriRegular p F G ω c → CNExt p F G ω h → IsIntDiv p F G → HasDecomp p F G

/-- Finite decidability of the allowed-pair predicate. -/
instance instDecidableAllowedPair {t : ℕ} (F : Finset (Multiset (Fin t))) (i j : Fin t) :
    Decidable (AllowedPair F i j) := by
  unfold AllowedPair; infer_instance

/-- The allowed non-neighbours of `v`. -/
def missSet (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    [DecidableRel G.Adj] (v : V) : Finset V :=
  univ.filter fun r => v ≠ r ∧ AllowedPair F (p v) (p r) ∧ ¬ G.Adj v r

/-- The number of allowed non-neighbours of `v`. -/
def missDeg (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    [DecidableRel G.Adj] (v : V) : ℕ := (missSet p F G v).card

/-- Eligible third vertices of class `c` for a pair of classes `s`. -/
def nPrime (nc : Fin t → ℝ) (s : Multiset (Fin t)) (c : Fin t) : ℝ := nc c - s.count c

/-- Class sizes. -/
def clsz {t : ℕ} {V : Type u_1} [Fintype V] (p : V → Fin t) (c : Fin t) : ℝ := ((univ.filter fun v => p v = c).card : ℝ)

/-- Balanced type weights (finite condition on the family). -/
def BalancedWeights (F : Finset (Multiset (Fin t))) (w : Multiset (Fin t) → ℝ) : Prop :=
  (∀ τ ∈ F, 0 < w τ) ∧ ∀ a b, AllowedPair F a b →
    ∑ c ∈ univ.filter (fun c => c ::ₘ ({a, b} : Multiset (Fin t)) ∈ F),
      w (c ::ₘ ({a, b} : Multiset (Fin t))) = t

/-- Paper II, Theorem B: nearly complete hosts with positive type weights. -/

theorem teoremaB_of_keevash {F : Finset (Multiset (Fin t))} (hK : KeevashTypedSpec F)
    (γ ω₁ : ℝ) (hγ : 0 < γ) (hω₁ : 0 < ω₁) :
    ∃ ε : ℝ, 0 < ε ∧ ∃ (N : ℕ) (δ : ℝ), 0 < δ ∧
      ∀ {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]
        (p : V → Fin t) (d : ℕ), N ≤ Fintype.card V →
        (∀ u v, G.Adj u v → AllowedPair F (p u) (p v)) → (∀ v, missDeg p F G v ≤ d) →
        (d : ℝ) ≤ δ * Fintype.card V →
        (∀ i, γ * Fintype.card V ≤ ((univ.filter fun v => p v = i).card : ℝ)) →
        (∃ wt : Multiset (Fin t) → ℝ, (∀ τ ∈ F, ω₁ ≤ wt τ ∧ wt τ ≤ 1 / ω₁) ∧
          ∀ a b, AllowedPair F a b →
            |(∑ τ ∈ F, wt τ * ((∑ c ∈ univ.filter (fun c => c ::ₘ ({a, b} : Multiset (Fin t)) = τ),
              nPrime (clsz p) {a, b} c) / Fintype.card V)) - 1| ≤ ε) →
        IsIntDiv p F G.edgeFinset → HasDecomp p F G.edgeFinset := by
  sorry

/-- The balanced consequence of Theorem B; the finite weight condition is retained. -/

theorem teoremaB_balanced {F : Finset (Multiset (Fin t))} (hK : KeevashTypedSpec F)
    (w : Multiset (Fin t) → ℝ) (hw : BalancedWeights F w) (ht : 1 ≤ t) :
    ∃ η : ℝ, 0 < η ∧ ∃ (N : ℕ) (δ : ℝ), 0 < δ ∧
      ∀ {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]
        (p : V → Fin t) (d : ℕ), N ≤ Fintype.card V →
        (∀ u v, G.Adj u v → AllowedPair F (p u) (p v)) → (∀ v, missDeg p F G v ≤ d) →
        (d : ℝ) ≤ δ * Fintype.card V →
        (∀ i, (1 / t - η) * Fintype.card V ≤ ((univ.filter fun v => p v = i).card : ℝ) ∧
          ((univ.filter fun v => p v = i).card : ℝ) ≤ (1 / t + η) * Fintype.card V) →
        IsIntDiv p F G.edgeFinset → HasDecomp p F G.edgeFinset := by
  sorry

end PartitionedTriangleAbsorption.BlowupB

